@model TroiSinhVien.Models.InputModels.RecordPaymentInputModel
@{ Layout="_ManagementLayout"; ViewData["Title"]="Ghi nhận thanh toán"; }
<h1 class="text-2xl font-bold">Ghi nhận thanh toán</h1><form method="post" enctype="multipart/form-data" class="mt-6 max-w-xl space-y-4 rounded-2xl bg-white p-6"><div asp-validation-summary="All" class="text-rose-600"></div><label class="block">Hóa đơn<select asp-for="InvoiceId" asp-items="ViewBag.Invoices" class="mt-1 w-full rounded-lg border p-3"><option value="">Chọn hóa đơn còn nợ</option></select></label><label class="block">Số tiền<input asp-for="Amount" class="mt-1 w-full rounded-lg border p-3"/></label><label class="block">Phương thức<select asp-for="Method" asp-items="Html.GetEnumSelectList<TroiSinhVien.Domain.Enums.PaymentMethod>()" class="mt-1 w-full rounded-lg border p-3"></select></label><label class="block">Mã tham chiếu<input asp-for="ReferenceCode" class="mt-1 w-full rounded-lg border p-3"/></label><button class="rounded-xl bg-indigo-600 px-5 py-3 text-white">Xác nhận thu tiền</button></form>
