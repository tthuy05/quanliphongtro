@model IReadOnlyList<TroiSinhVien.Models.ViewModels.PaymentListItem>
@{ Layout="_ManagementLayout"; ViewData["Title"]="Thanh toán"; }
<h1 class="text-2xl font-bold">Thanh toán</h1><div class="mt-6 overflow-x-auto rounded-2xl bg-white"><table class="w-full text-sm"><thead class="bg-slate-50 text-left"><tr><th class="p-4">Hóa đơn</th><th>Số tiền</th><th>Phương thức</th><th>Trạng thái</th><th>Ngày</th><th>Chứng từ</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr class="border-t"><td class="p-4">@x.InvoiceNumber</td><td>@x.Amount.ToString("N0") ₫</td><td>@x.Method</td><td>@x.Status</td><td>@x.PaidAt.ToString("dd/MM/yyyy")</td><td>@if(x.EvidenceFileId.HasValue){<a href="/PaymentEvidence/@x.Id" class="text-indigo-600">Xem</a>}</td><td>@if(x.Status==TroiSinhVien.Domain.Enums.PaymentStatus.Pending){<div class="flex flex-wrap gap-2"><form asp-action="Confirm" method="post"><input type="hidden" name="PaymentId" value="@x.Id"/><button class="text-emerald-600">Xác nhận</button></form><form asp-action="Reject" method="post" class="flex gap-1"><input type="hidden" name="PaymentId" value="@x.Id"/><input name="Reason" required maxlength="500" placeholder="Lý do" class="w-28 rounded border px-2"/><button class="text-rose-600">Từ chối</button></form></div>}</td></tr>}@if(Model.Count==0){<tr><td colspan="7" class="p-10 text-center text-slate-500">Chưa có thanh toán.</td></tr>}</tbody></table></div>
