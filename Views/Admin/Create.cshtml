@model TroiSinhVien.Models.InputModels.CreateSystemUserInputModel
@{ Layout = "_ManagementLayout"; ViewData["Title"] = "Tạo tài khoản"; }
<h1 class="text-2xl font-bold">Tạo tài khoản hệ thống</h1><p class="mt-1 text-sm text-slate-500">Tài khoản Tenant phải gắn với hồ sơ người thuê đã được chủ trọ tạo.</p>
<form method="post" class="mt-6 grid max-w-3xl gap-4 rounded-2xl bg-white p-6 sm:grid-cols-2"><div asp-validation-summary="All" class="text-rose-600 sm:col-span-2"></div><label>Họ tên<input asp-for="DisplayName" class="mt-1 w-full rounded-lg border p-3"/></label><label>Email<input asp-for="Email" class="mt-1 w-full rounded-lg border p-3"/></label><label>Điện thoại<input asp-for="PhoneNumber" class="mt-1 w-full rounded-lg border p-3"/></label><label>Vai trò<select asp-for="Role" class="mt-1 w-full rounded-lg border p-3">@foreach(var role in TroiSinhVien.Domain.Constants.SystemRoles.All){<option value="@role">@role</option>}</select></label><label>Hồ sơ người thuê<select asp-for="TenantProfileId" asp-items="ViewBag.TenantProfiles" class="mt-1 w-full rounded-lg border p-3"><option value="">Không liên kết</option></select></label><div></div><label>Mật khẩu<input asp-for="Password" class="mt-1 w-full rounded-lg border p-3"/></label><label>Nhập lại mật khẩu<input asp-for="ConfirmPassword" class="mt-1 w-full rounded-lg border p-3"/></label><button class="rounded-xl bg-indigo-600 px-5 py-3 text-white sm:col-span-2">Tạo tài khoản</button></form>
