@model IReadOnlyList<TroiSinhVien.Models.ViewModels.AdminUserListItem>
@{ Layout = "_ManagementLayout"; ViewData["Title"] = "Quản trị người dùng"; }
<div class="flex flex-wrap justify-between gap-3"><h1 class="text-2xl font-bold">Tài khoản hệ thống</h1><div class="flex gap-4"><a href="/Admin/Create" class="font-semibold text-indigo-600">Tạo tài khoản</a><a href="/Admin/Audit" class="text-indigo-600">Nhật ký audit</a></div></div>
<div class="mt-6 overflow-x-auto rounded-2xl bg-white"><table class="w-full text-sm"><thead class="bg-slate-50 text-left"><tr><th class="p-4">Email</th><th>Tên</th><th>Vai trò</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var x in Model){<tr class="border-t"><td class="p-4">@x.Email</td><td>@x.DisplayName</td><td><form asp-action="ChangeRole" method="post" class="flex gap-2"><input type="hidden" name="id" value="@x.Id"/><select name="role" class="rounded-lg border px-2 py-1">@foreach(var role in TroiSinhVien.Domain.Constants.SystemRoles.All){if(role == x.Role){<option value="@role" selected>@role</option>}else{<option value="@role">@role</option>}}</select><button class="text-indigo-600">Lưu</button></form></td><td>@(x.IsActive ? "Hoạt động" : "Khóa")</td><td><form action="/Admin/@(x.IsActive ? "Lock" : "Unlock")" method="post"><input type="hidden" name="id" value="@x.Id"/><button class="text-indigo-600">@(x.IsActive ? "Khóa" : "Mở khóa")</button></form></td></tr>}@if(Model.Count == 0){<tr><td colspan="5" class="p-10 text-center text-slate-500">Chưa có tài khoản.</td></tr>}</tbody></table></div>
