@model IReadOnlyList<TroiSinhVien.Models.ViewModels.AuditLogListItem>
@{ Layout="_ManagementLayout"; ViewData["Title"]="Nhật ký audit"; }
<h1 class="text-2xl font-bold">Nhật ký audit</h1><div class="mt-6 overflow-x-auto rounded-2xl bg-white"><table class="w-full text-sm"><thead class="bg-slate-50 text-left"><tr><th class="p-4">Thời gian UTC</th><th>Hành động</th><th>Đối tượng</th><th>Tóm tắt</th></tr></thead><tbody>@foreach(var x in Model){<tr class="border-t"><td class="p-4">@x.Timestamp</td><td>@x.Action</td><td>@x.EntityType #@x.EntityId</td><td>@x.Summary</td></tr>}</tbody></table></div>
