@model TroiSinhVien.Models.InputModels.BoardingHouseInputModel
@{ Layout = "_ManagementLayout"; ViewData["Title"] = ViewData["FormTitle"] ?? "Thêm khu trọ"; }
<h1 class="text-2xl font-bold">@ViewData["Title"]</h1><form method="post" class="mt-6 max-w-2xl space-y-4 rounded-2xl bg-white p-6 shadow-sm"><div asp-validation-summary="ModelOnly" class="text-rose-600"></div><label class="block">Tên<input asp-for="Name" class="mt-1 w-full rounded-lg border p-3"/></label><label class="block">Địa chỉ<textarea asp-for="Address" class="mt-1 w-full rounded-lg border p-3"></textarea></label><label class="block">Điện thoại<input asp-for="ContactPhone" class="mt-1 w-full rounded-lg border p-3"/></label><div class="grid gap-4 sm:grid-cols-2"><label>Giá điện<input asp-for="DefaultElectricityPrice" class="mt-1 w-full rounded-lg border p-3"/></label><label>Giá nước<input asp-for="DefaultWaterPrice" class="mt-1 w-full rounded-lg border p-3"/></label></div><button class="rounded-xl bg-indigo-600 px-5 py-3 text-white">Lưu</button></form>
