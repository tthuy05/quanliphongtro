@model IReadOnlyList<TroiSinhVien.Models.ViewModels.BoardingHouseListItem>
@{ Layout = "_ManagementLayout"; ViewData["Title"] = "Khu trọ"; }
<div class="flex items-center justify-between"><h1 class="text-2xl font-bold">Khu trọ</h1><a asp-action="Create" class="rounded-xl bg-indigo-600 px-4 py-2 text-white">Thêm khu trọ</a></div><div class="mt-6 overflow-x-auto rounded-2xl bg-white shadow-sm"><table class="w-full text-sm"><thead class="bg-slate-50 text-left"><tr><th class="p-4">Tên</th><th>Địa chỉ</th><th>Phòng</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr class="border-t"><td class="p-4 font-semibold"><a asp-action="Details" asp-route-id="@x.Id" class="text-indigo-600">@x.Name</a></td><td>@x.Address</td><td>@x.RoomCount</td><td>@(x.IsActive ? "Hoạt động" : "Ngừng")</td><td><div class="flex gap-3"><a asp-action="Edit" asp-route-id="@x.Id" class="text-indigo-600">Sửa</a>@if(x.IsActive){<form asp-action="Deactivate" method="post"><input type="hidden" name="id" value="@x.Id"/><button class="text-rose-600">Ngừng</button></form>}else{<form asp-action="Activate" method="post"><input type="hidden" name="id" value="@x.Id"/><button class="text-emerald-600">Kích hoạt</button></form>}</div></td></tr>}@if(Model.Count == 0){<tr><td colspan="5" class="p-10 text-center text-slate-500">Chưa có khu trọ. Hãy tạo khu trọ đầu tiên.</td></tr>}</tbody></table></div>
