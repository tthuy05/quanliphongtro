@model TroiSinhVien.Models.ViewModels.BoardingHouseDetailsViewModel
@{ Layout = "_ManagementLayout"; ViewData["Title"] = Model.Property.Name; }
<div class="flex flex-wrap justify-between gap-3"><div><a asp-action="Index" class="text-sm text-indigo-600">← Khu trọ</a><h1 class="mt-2 text-2xl font-bold">@Model.Property.Name</h1><p class="mt-1 text-slate-500">@Model.Property.Address · @(Model.Property.IsActive ? "Hoạt động" : "Đã ngừng")</p></div><a asp-action="Edit" asp-route-id="@Model.Property.Id" class="rounded-xl border px-4 py-2 self-start">Chỉnh sửa</a></div><section class="mt-6 rounded-2xl bg-white p-6"><dl class="grid gap-4 text-sm sm:grid-cols-3"><div><dt class="text-slate-500">Điện thoại</dt><dd class="font-semibold">@(Model.Property.ContactPhone ?? "—")</dd></div><div><dt class="text-slate-500">Giá điện mặc định</dt><dd class="font-semibold">@Model.DefaultElectricityPrice.ToString("N0") ₫</dd></div><div><dt class="text-slate-500">Giá nước mặc định</dt><dd class="font-semibold">@Model.DefaultWaterPrice.ToString("N0") ₫</dd></div></dl></section><section class="mt-6 rounded-2xl bg-white p-6"><div class="flex justify-between"><h2 class="font-bold">Danh sách phòng</h2><a href="/Rooms/Create?propertyId=@Model.Property.Id" class="text-indigo-600">Thêm phòng</a></div><div class="mt-4 grid gap-3 md:grid-cols-2">@foreach(var room in Model.Rooms){<a href="/Rooms/Details/@room.Id" class="rounded-xl bg-slate-50 p-4"><b>@room.RoomCode</b><div class="mt-1 text-sm text-slate-500">@room.Status · @room.MonthlyRent.ToString("N0") ₫ · tối đa @room.MaximumOccupants người</div></a>}@if(Model.Rooms.Count == 0){<p class="text-sm text-slate-500">Chưa có phòng.</p>}</div></section>
