@model IReadOnlyList<TroiSinhVien.Models.ViewModels.NotificationListItem>
@{ Layout = "_ManagementLayout"; ViewData["Title"] = "Thông báo"; }
<div class="flex flex-wrap items-center justify-between gap-3"><div><h1 class="text-2xl font-bold">Thông báo</h1><p class="mt-1 text-sm text-slate-500">Hóa đơn, hợp đồng, thanh toán và bảo trì.</p></div><form asp-action="MarkAllRead" method="post"><button class="text-sm font-semibold text-indigo-600">Đánh dấu tất cả đã đọc</button></form></div>
<div class="mt-6 space-y-3">
    @if (Model.Count == 0) { <div class="rounded-2xl bg-white p-8 text-center text-slate-500">Không có thông báo.</div> }
    @foreach (var x in Model)
    {
        <article class="rounded-2xl bg-white p-5 shadow-sm @(x.ReadAt is null ? "border-l-4 border-indigo-500" : "")">
            <div class="flex flex-wrap items-start justify-between gap-3"><div><div class="font-bold">@x.Title</div><p class="mt-1 text-sm text-slate-600">@x.Message</p><div class="mt-2 text-xs text-slate-400">@x.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div></div><span class="rounded-full bg-slate-100 px-3 py-1 text-xs">@x.Type</span></div>
            <div class="mt-3 flex gap-4 text-sm">
                @if (x.ReadAt is null) { <form asp-action="MarkRead" method="post"><input type="hidden" name="id" value="@x.Id" /><input type="hidden" name="returnUrl" value="@x.LinkUrl" /><button class="font-semibold text-indigo-600">@(string.IsNullOrWhiteSpace(x.LinkUrl) ? "Đánh dấu đã đọc" : "Đọc và mở")</button></form> }
                else if (!string.IsNullOrWhiteSpace(x.LinkUrl)) { <a href="@x.LinkUrl" class="font-semibold text-indigo-600">Mở chi tiết</a> }
            </div>
        </article>
    }
</div>
