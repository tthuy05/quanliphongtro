@model TroiSinhVien.Models.InputModels.RecordPaymentInputModel
@{ Layout="_ManagementLayout"; ViewData["Title"]="Gửi thanh toán"; }
<h1 class="text-2xl font-bold">Gửi minh chứng thanh toán</h1><form method="post" enctype="multipart/form-data" class="mt-6 max-w-xl space-y-4 rounded-2xl bg-white p-6"><div asp-validation-summary="All" class="text-rose-600"></div><input asp-for="InvoiceId" type="hidden"/><input asp-for="Method" type="hidden"/><label class="block">Số tiền<input asp-for="Amount" class="mt-1 w-full rounded-lg border p-3"/></label><label class="block">Mã giao dịch<input asp-for="ReferenceCode" class="mt-1 w-full rounded-lg border p-3"/></label><label class="block">Ảnh minh chứng<input asp-for="Evidence" accept="image/jpeg,image/png,image/webp" class="mt-1 w-full rounded-lg border p-3"/></label><button class="rounded-xl bg-indigo-600 px-5 py-3 text-white">Gửi chờ xác nhận</button></form>
