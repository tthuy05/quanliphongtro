@model IReadOnlyList<TroiSinhVien.Models.ViewModels.MaintenanceListItem>
@{ Layout = "_ManagementLayout"; ViewData["Title"] = "Sửa chữa của tôi"; }
<div class="flex flex-wrap items-center justify-between gap-3"><div><h1 class="text-2xl font-bold">Yêu cầu sửa chữa của tôi</h1><p class="mt-1 text-sm text-slate-500">Mở yêu cầu để xem phản hồi từ chủ trọ.</p></div><a href="/Tenant/Maintenance/Create" class="rounded-xl bg-indigo-600 px-4 py-2 text-white">Tạo yêu cầu</a></div>
<div class="mt-6 space-y-3">
    @if (Model.Count == 0) { <div class="rounded-2xl bg-white p-8 text-center text-slate-500">Bạn chưa gửi yêu cầu nào.</div> }
    @foreach (var x in Model)
    {
        <a asp-controller="Tenant" asp-action="MaintenanceDetails" asp-route-id="@x.Id" class="block rounded-2xl bg-white p-5 shadow-sm transition hover:shadow-md">
            <div class="flex flex-wrap items-start justify-between gap-3"><div><b>@x.Title</b><div class="mt-1 text-sm text-slate-500">@x.RoomCode · @x.Category · @x.Priority · @x.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div></div><span class="rounded-full bg-slate-100 px-3 py-1 text-sm">@x.Status</span></div>
        </a>
    }
</div>
