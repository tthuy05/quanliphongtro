@model IReadOnlyList<TroiSinhVien.Models.ViewModels.InvoiceListItem>
@{ Layout="_ManagementLayout"; ViewData["Title"]="Hóa đơn của tôi"; }
<h1 class="text-2xl font-bold">Hóa đơn của tôi</h1><div class="mt-6 grid gap-4 md:grid-cols-2">@foreach(var x in Model){<article class="rounded-2xl bg-white p-5"><div class="flex justify-between"><a href="/Tenant/Invoices/@x.Id" class="font-bold text-indigo-600">@x.InvoiceNumber</a><span>@x.Status</span></div><div class="mt-2 text-sm">Phòng @x.RoomCode · @x.BillingMonth/@x.BillingYear</div><div class="mt-4 text-xl font-bold">Còn @x.RemainingAmount.ToString("N0") ₫</div>@if(x.RemainingAmount>0 && x.Status!=TroiSinhVien.Domain.Enums.InvoiceStatus.Draft){<a href="/Tenant/Payment/@x.Id" class="mt-4 inline-block rounded-lg bg-indigo-600 px-4 py-2 text-white">Gửi minh chứng</a>}</article>}@if(Model.Count==0){<p class="text-slate-500">Bạn chưa có hóa đơn.</p>}</div>
