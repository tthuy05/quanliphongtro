@model TroiSinhVien.Models.InputModels.CreateMaintenanceRequestInputModel
@{ Layout="_ManagementLayout"; ViewData["Title"]="Tạo yêu cầu sửa chữa"; }
<h1 class="text-2xl font-bold">Tạo yêu cầu sửa chữa</h1><form method="post" class="mt-6 max-w-xl space-y-4 rounded-2xl bg-white p-6"><div asp-validation-summary="All" class="text-rose-600"></div><label class="block">Hạng mục<input asp-for="Category" class="mt-1 w-full rounded-lg border p-3"/></label><label class="block">Tiêu đề<input asp-for="Title" class="mt-1 w-full rounded-lg border p-3"/></label><label class="block">Mô tả<textarea asp-for="Description" class="mt-1 w-full rounded-lg border p-3"></textarea></label><label class="block">Mức độ<select asp-for="Priority" asp-items="Html.GetEnumSelectList<TroiSinhVien.Domain.Enums.MaintenancePriority>()" class="mt-1 w-full rounded-lg border p-3"></select></label><button class="rounded-xl bg-indigo-600 px-5 py-3 text-white">Gửi yêu cầu</button></form>
