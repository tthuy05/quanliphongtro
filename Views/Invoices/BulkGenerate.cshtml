@model TroiSinhVien.Models.InputModels.BulkGenerateInvoiceInputModel
@{ Layout = "_ManagementLayout"; ViewData["Title"] = "Tạo hóa đơn hàng loạt"; }
<h1 class="text-2xl font-bold">Tạo hóa đơn hàng loạt</h1><p class="mt-1 text-sm text-slate-500">Tạo hóa đơn nháp cho mọi hợp đồng hiệu lực trong khu trọ; kỳ đã có hóa đơn sẽ được bỏ qua.</p><form method="post" class="mt-6 max-w-xl space-y-4 rounded-2xl bg-white p-6"><div asp-validation-summary="All" class="text-rose-600"></div><label class="block">Khu trọ<select asp-for="BoardingHouseId" asp-items="ViewBag.Properties" class="mt-1 w-full rounded-lg border p-3"><option value="">Chọn khu trọ</option></select></label><div class="grid grid-cols-2 gap-4"><label>Tháng<input asp-for="BillingMonth" class="mt-1 w-full rounded-lg border p-3"/></label><label>Năm<input asp-for="BillingYear" class="mt-1 w-full rounded-lg border p-3"/></label></div><button class="rounded-xl bg-indigo-600 px-5 py-3 text-white">Tạo hóa đơn nháp</button></form>
