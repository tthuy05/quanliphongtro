@model TroiSinhVien.Models.ViewModels.InvoiceDetailsViewModel
@{ Layout="_ManagementLayout"; ViewData["Title"]=$"Hóa đơn {Model.Invoice.InvoiceNumber}"; }
<div class="flex flex-wrap items-start justify-between gap-3"><div><h1 class="text-2xl font-bold">@Model.Invoice.InvoiceNumber</h1><p class="text-sm text-slate-500">Phòng @Model.Invoice.RoomCode · Kỳ @Model.Invoice.BillingMonth/@Model.Invoice.BillingYear · @Model.Invoice.Status</p></div><a href="@(Model.IsTenantView?"/Tenant/Invoices":"/Invoices")" class="text-indigo-600">Quay lại</a></div>
<div class="mt-6 grid gap-5 lg:grid-cols-3"><section class="overflow-x-auto rounded-2xl bg-white lg:col-span-2"><table class="w-full text-sm"><thead class="bg-slate-50 text-left"><tr><th class="p-4">Nội dung</th><th>SL</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead><tbody>@foreach(var row in Model.Details){<tr class="border-t"><td class="p-4"><b>@row.Description</b><div class="text-xs text-slate-500">@row.SourceType</div></td><td>@row.Quantity @row.Unit</td><td>@row.UnitPrice.ToString("N0") ₫</td><td>@row.Amount.ToString("N0") ₫</td></tr>}</tbody></table></section><aside class="rounded-2xl bg-white p-5"><h2 class="font-bold">Tổng kết</h2><dl class="mt-4 space-y-2 text-sm"><div class="flex justify-between"><dt>Tổng hóa đơn</dt><dd>@Model.Invoice.TotalAmount.ToString("N0") ₫</dd></div><div class="flex justify-between"><dt>Đã trả</dt><dd>@Model.Invoice.PaidAmount.ToString("N0") ₫</dd></div><div class="flex justify-between text-lg font-bold"><dt>Còn lại</dt><dd>@Model.Invoice.RemainingAmount.ToString("N0") ₫</dd></div><div class="flex justify-between border-t pt-2 text-slate-500"><dt>Nợ kỳ trước (riêng)</dt><dd>@Model.PriorOutstandingDebt.ToString("N0") ₫</dd></div><div class="flex justify-between text-slate-500"><dt>Tổng nợ hợp đồng</dt><dd>@Model.AccountOutstandingDebt.ToString("N0") ₫</dd></div></dl></aside></div>
<section class="mt-5 rounded-2xl bg-white p-5"><h2 class="font-bold">Lịch sử thanh toán</h2><div class="mt-3 space-y-3">@foreach(var payment in Model.Payments){<article class="flex flex-wrap items-center justify-between gap-3 rounded-xl bg-slate-50 p-3"><div><b>@payment.Amount.ToString("N0") ₫</b><div class="text-xs text-slate-500">@payment.Method · @payment.PaidAt.ToString("dd/MM/yyyy HH:mm") · @payment.Status</div>@if(!string.IsNullOrWhiteSpace(payment.RejectionReason)){<div class="text-xs text-rose-600">@payment.RejectionReason</div>}</div>@if(payment.EvidenceFileId.HasValue){<a href="/PaymentEvidence/@payment.Id" class="text-sm text-indigo-600">Xem chứng từ</a>}</article>}@if(Model.Payments.Count==0){<p class="text-sm text-slate-500">Chưa có thanh toán.</p>}</div></section>
