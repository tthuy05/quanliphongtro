@model TroiSinhVien.Models.InputModels.GenerateInvoiceInputModel
@{ Layout="_ManagementLayout"; ViewData["Title"]="Tạo hóa đơn"; }
<h1 class="text-2xl font-bold">Tạo hóa đơn nháp</h1><form method="post" class="mt-6 max-w-xl space-y-4 rounded-2xl bg-white p-6"><div asp-validation-summary="All" class="text-rose-600"></div><label class="block">Hợp đồng<select asp-for="ContractId" asp-items="ViewBag.Contracts" class="mt-1 w-full rounded-lg border p-3"><option value="">Chọn hợp đồng hiệu lực</option></select></label><div class="grid grid-cols-2 gap-4"><label>Tháng<input asp-for="BillingMonth" class="mt-1 w-full rounded-lg border p-3"/></label><label>Năm<input asp-for="BillingYear" class="mt-1 w-full rounded-lg border p-3"/></label></div><label class="block">Giảm giá<input asp-for="DiscountAmount" class="mt-1 w-full rounded-lg border p-3"/></label><p class="text-xs text-slate-500">Các kỳ nợ cũ được giữ thành hóa đơn riêng để tránh tính trùng; đơn giá lấy từ snapshot hợp đồng.</p><button class="rounded-xl bg-indigo-600 px-5 py-3 text-white">Tạo nháp</button></form>
