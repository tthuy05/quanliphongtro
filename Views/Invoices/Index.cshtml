@model IReadOnlyList<TroiSinhVien.Models.ViewModels.InvoiceListItem>
@{ Layout = "_ManagementLayout"; ViewData["Title"] = "Hóa đơn"; }
<div class="flex flex-wrap justify-between gap-3"><h1 class="text-2xl font-bold">Hóa đơn</h1><div class="flex gap-3"><a href="/Invoices/BulkGenerate" class="rounded-xl border border-indigo-200 px-4 py-2 font-semibold text-indigo-700">Tạo hàng loạt</a><a href="/Invoices/Generate" class="rounded-xl bg-indigo-600 px-4 py-2 text-white">Tạo một hóa đơn</a></div></div>
<form method="get" class="mt-5 flex flex-wrap gap-2 rounded-2xl bg-white p-4"><select name="propertyId" asp-items="ViewBag.Properties" class="rounded-lg border p-2"><option value="">Mọi khu trọ</option></select><select name="status" class="rounded-lg border p-2" asp-items="Html.GetEnumSelectList<TroiSinhVien.Domain.Enums.InvoiceStatus>()"><option value="">Mọi trạng thái</option></select><input name="month" type="number" min="1" max="12" value="@Context.Request.Query["month"]" placeholder="Tháng" class="w-24 rounded-lg border p-2"/><input name="year" type="number" min="2000" max="2200" value="@Context.Request.Query["year"]" placeholder="Năm" class="w-28 rounded-lg border p-2"/><button class="rounded-lg bg-slate-900 px-4 py-2 text-white">Lọc</button><a href="/Invoices" class="rounded-lg px-4 py-2 text-slate-500">Xóa lọc</a></form>
<div class="mt-5 overflow-x-auto rounded-2xl bg-white"><table class="w-full text-sm"><thead class="bg-slate-50 text-left"><tr><th class="p-4">Số HĐ</th><th>Phòng</th><th>Kỳ</th><th>Tổng</th><th>Còn lại</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr class="border-t"><td class="p-4 font-semibold"><a asp-action="Details" asp-route-id="@x.Id" class="text-indigo-600">@x.InvoiceNumber</a></td><td>@x.RoomCode</td><td>@x.BillingMonth/@x.BillingYear</td><td>@x.TotalAmount.ToString("N0") ₫</td><td>@x.RemainingAmount.ToString("N0") ₫</td><td>@x.Status</td><td>@if(x.Status == TroiSinhVien.Domain.Enums.InvoiceStatus.Draft){<form asp-action="Issue" method="post"><input type="hidden" name="id" value="@x.Id"/><button class="text-indigo-600">Phát hành</button></form>}else if(x.RemainingAmount > 0){<a class="text-emerald-600" href="/Payments/Record?invoiceId=@x.Id">Thu tiền</a>}</td></tr>}@if(Model.Count == 0){<tr><td colspan="7" class="p-10 text-center text-slate-500">Không có hóa đơn phù hợp.</td></tr>}</tbody></table></div>
