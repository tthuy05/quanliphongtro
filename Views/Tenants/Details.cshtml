@model TroiSinhVien.Models.ViewModels.TenantDetailsViewModel
@{ Layout = "_ManagementLayout"; ViewData["Title"] = Model.Tenant.FullName; }
<div class="flex flex-wrap justify-between gap-3"><div><a asp-action="Index" class="text-sm text-indigo-600">← Người thuê</a><h1 class="mt-2 text-2xl font-bold">@Model.Tenant.FullName</h1><p class="mt-1 text-slate-500">@Model.Tenant.PhoneNumber · @(Model.Tenant.Email ?? "không có email")</p></div><a asp-action="Edit" asp-route-id="@Model.Tenant.Id" class="rounded-xl border px-4 py-2 self-start">Chỉnh sửa</a></div><section class="mt-6 rounded-2xl bg-white p-6"><h2 class="font-bold">Hồ sơ</h2><dl class="mt-4 grid gap-4 text-sm sm:grid-cols-3"><div><dt class="text-slate-500">Ngày sinh</dt><dd>@(Model.DateOfBirth?.ToString("dd/MM/yyyy") ?? "—")</dd></div><div><dt class="text-slate-500">Giấy tờ</dt><dd>@(Model.IdentityNumber ?? "—")</dd></div><div><dt class="text-slate-500">Ngày cấp</dt><dd>@(Model.IdentityIssueDate?.ToString("dd/MM/yyyy") ?? "—")</dd></div><div><dt class="text-slate-500">Biển số xe</dt><dd>@(Model.VehiclePlate ?? "—")</dd></div><div><dt class="text-slate-500">Liên hệ khẩn cấp</dt><dd>@(Model.EmergencyContactName ?? "—") · @(Model.EmergencyContactPhone ?? "—")</dd></div><div><dt class="text-slate-500">Địa chỉ thường trú</dt><dd>@(Model.PermanentAddress ?? "—")</dd></div></dl></section><div class="mt-6 grid gap-6 lg:grid-cols-2"><section class="rounded-2xl bg-white p-6"><h2 class="font-bold">Lịch sử cư trú</h2><div class="mt-3 space-y-2">@foreach(var item in Model.Residences){<div class="rounded-xl bg-slate-50 p-3 text-sm"><b>@item.BoardingHouseName · @item.RoomCode</b><div class="text-slate-500">@item.MoveInDate – @(item.MoveOutDate?.ToString() ?? "hiện tại")</div></div>}@if(Model.Residences.Count == 0){<p class="text-sm text-slate-500">Chưa có lịch sử cư trú.</p>}</div></section><section class="rounded-2xl bg-white p-6"><h2 class="font-bold">Hợp đồng</h2><div class="mt-3 space-y-2">@foreach(var contract in Model.Contracts){<a href="/Contracts/Details/@contract.Id" class="block rounded-xl bg-slate-50 p-3 text-sm"><b>@contract.ContractCode</b><div class="text-slate-500">Phòng @contract.RoomCode · @contract.Status</div></a>}@if(Model.Contracts.Count == 0){<p class="text-sm text-slate-500">Chưa có hợp đồng.</p>}</div></section></div>
