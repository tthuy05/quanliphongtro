@model TroiSinhVien.Models.InputModels.TenantInputModel
@{ Layout="_ManagementLayout"; ViewData["Title"] = ViewData["FormTitle"] ?? "Thêm người thuê"; }
<h1 class="text-2xl font-bold">@(ViewData["FormTitle"] ?? "Thêm người thuê")</h1>
<form method="post" class="mt-6 grid max-w-3xl gap-4 rounded-2xl bg-white p-6 sm:grid-cols-2"><div asp-validation-summary="All" class="text-rose-600 sm:col-span-2"></div><label>Họ tên<input asp-for="FullName" class="mt-1 w-full rounded-lg border p-3"/></label><label>Điện thoại<input asp-for="PhoneNumber" class="mt-1 w-full rounded-lg border p-3"/></label><label>Email<input asp-for="Email" class="mt-1 w-full rounded-lg border p-3"/></label><label>Ngày sinh<input asp-for="DateOfBirth" type="date" class="mt-1 w-full rounded-lg border p-3"/></label><label>Số giấy tờ<input asp-for="IdentityNumber" class="mt-1 w-full rounded-lg border p-3"/></label><label>Ngày cấp<input asp-for="IdentityIssueDate" type="date" class="mt-1 w-full rounded-lg border p-3"/></label><label>Biển số xe<input asp-for="VehiclePlate" class="mt-1 w-full rounded-lg border p-3"/></label><label>Liên hệ khẩn cấp<input asp-for="EmergencyContactName" class="mt-1 w-full rounded-lg border p-3"/></label><label>Điện thoại khẩn cấp<input asp-for="EmergencyContactPhone" class="mt-1 w-full rounded-lg border p-3"/></label><label class="sm:col-span-2">Địa chỉ thường trú<textarea asp-for="PermanentAddress" class="mt-1 w-full rounded-lg border p-3"></textarea></label><button class="rounded-xl bg-indigo-600 px-5 py-3 text-white sm:col-span-2">Lưu hồ sơ</button></form>
