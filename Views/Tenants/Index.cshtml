@model IReadOnlyList<TroiSinhVien.Models.ViewModels.TenantListItem>
@{ Layout = "_ManagementLayout"; ViewData["Title"] = "Người thuê"; }
<div class="flex justify-between"><h1 class="text-2xl font-bold">Người thuê</h1><a asp-action="Create" class="rounded-xl bg-indigo-600 px-4 py-2 text-white">Thêm người thuê</a></div><form method="get" class="mt-4 flex gap-2"><input name="search" value="@Context.Request.Query["search"]" placeholder="Tìm tên hoặc điện thoại" class="rounded-xl border px-4 py-2"/><button class="rounded-xl bg-slate-800 px-4 text-white">Tìm</button></form><div class="mt-6 overflow-x-auto rounded-2xl bg-white"><table class="w-full text-sm"><thead class="bg-slate-50 text-left"><tr><th class="p-4">Họ tên</th><th>Điện thoại</th><th>Email</th><th>Phòng hiện tại</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr class="border-t"><td class="p-4 font-semibold"><a asp-action="Details" asp-route-id="@x.Id" class="text-indigo-600">@x.FullName</a></td><td>@x.PhoneNumber</td><td>@x.Email</td><td>@(x.CurrentRoomCode ?? "—")</td><td><a asp-action="Edit" asp-route-id="@x.Id" class="text-indigo-600">Sửa</a></td></tr>}@if(Model.Count == 0){<tr><td colspan="5" class="p-10 text-center text-slate-500">Chưa có hồ sơ người thuê.</td></tr>}</tbody></table></div>
