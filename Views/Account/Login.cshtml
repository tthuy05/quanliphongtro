@model TroiSinhVien.Models.InputModels.LoginInputModel
@{ Layout = null; }
<!doctype html><html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Đăng nhập | Trọ Sinh Viên</title><link rel="stylesheet" href="~/css/tailwind.generated.css" asp-append-version="true"/></head>
<body class="min-h-screen bg-slate-950 flex items-center justify-center p-4"><main class="w-full max-w-md rounded-3xl bg-white p-8 shadow-2xl">
<h1 class="text-2xl font-bold text-slate-900">Đăng nhập</h1><p class="mt-2 text-sm text-slate-500">Quản lý nhà trọ an toàn và tập trung.</p>
<form asp-action="Login" method="post" class="mt-7 space-y-5"><input asp-for="ReturnUrl" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-sm text-rose-600"></div>
<div><label asp-for="Email" class="text-sm font-semibold">Email</label><input asp-for="Email" autocomplete="username" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3"/><span asp-validation-for="Email" class="text-xs text-rose-600"></span></div>
<div><label asp-for="Password" class="text-sm font-semibold">Mật khẩu</label><input asp-for="Password" autocomplete="current-password" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3"/><span asp-validation-for="Password" class="text-xs text-rose-600"></span></div>
<label class="flex items-center gap-2 text-sm"><input asp-for="RememberMe"/> Ghi nhớ đăng nhập</label><button class="w-full rounded-xl bg-indigo-600 px-4 py-3 font-bold text-white hover:bg-indigo-700">Đăng nhập</button></form>
</main></body></html>
