@model TroiSinhVien.Models.InputModels.LoginInputModel
@{ Layout = null; }
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng nhập | Trọ Sinh Viên</title>
    <link rel="stylesheet" href="~/css/tailwind.generated.css" asp-append-version="true" />
</head>
<body class="relative flex min-h-screen items-center justify-center overflow-hidden bg-cover bg-center bg-no-repeat p-4"
      style="background-image: url('@Url.Content("~/images/auth/login-nature.jpg")');">
    <div class="absolute inset-0 bg-slate-950/35" aria-hidden="true"></div>

    <main class="relative z-10 w-full max-w-md rounded-lg border border-white/70 bg-white/95 p-6 shadow-2xl backdrop-blur-sm sm:p-8">
        <h1 class="text-2xl font-bold text-slate-900">Đăng nhập</h1>
        <p class="mt-2 text-sm text-slate-600">Quản lý nhà trọ an toàn và tập trung.</p>

        <aside class="mt-5 rounded-xl border border-indigo-200 bg-indigo-50 px-4 py-3" aria-label="Tài khoản demo">
            <p class="text-sm font-semibold text-indigo-700">Tài khoản demo</p>
            <dl class="mt-2 space-y-1 text-sm text-slate-700">
                <div class="flex flex-wrap gap-x-2">
                    <dt class="font-medium">Email:</dt>
                    <dd class="select-all">vana&#64;gmail.com</dd>
                </div>
                <div class="flex flex-wrap gap-x-2">
                    <dt class="font-medium">Mật khẩu:</dt>
                    <dd class="select-all">12345Ab&#64;</dd>
                </div>
            </dl>
        </aside>

        <form asp-action="Login" method="post" class="mt-5 space-y-5">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-sm text-rose-600"></div>

            <div>
                <label asp-for="Email" class="text-sm font-semibold">Email</label>
                <input asp-for="Email" autocomplete="username" class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3" />
                <span asp-validation-for="Email" class="text-xs text-rose-600"></span>
            </div>

            <div>
                <label asp-for="Password" class="text-sm font-semibold">Mật khẩu</label>
                <div class="relative mt-2">
                    <input asp-for="Password" autocomplete="current-password" class="w-full rounded-xl border border-slate-200 bg-white py-3 pl-4 pr-12" />
                    <button id="toggle-password" type="button"
                            class="absolute inset-y-0 right-2 flex h-full w-10 items-center justify-center text-slate-500 hover:text-slate-900"
                            aria-label="Hiện mật khẩu" aria-pressed="false" title="Hiện mật khẩu">
                        <i data-lucide="eye" class="h-5 w-5" aria-hidden="true"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-xs text-rose-600"></span>
            </div>

            <label class="flex items-center gap-2 text-sm">
                <input asp-for="RememberMe" /> Ghi nhớ đăng nhập
            </label>
            <button class="w-full rounded-xl bg-indigo-600 px-4 py-3 font-bold text-white hover:bg-indigo-700">Đăng nhập</button>
        </form>
    </main>

    <script src="~/vendor/lucide.js" asp-append-version="true"></script>
    <script>
        const passwordInput = document.getElementById("Password");
        const passwordToggle = document.getElementById("toggle-password");

        passwordToggle.addEventListener("click", () => {
            const showPassword = passwordInput.type === "password";
            passwordInput.type = showPassword ? "text" : "password";

            const label = showPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu";
            passwordToggle.setAttribute("aria-label", label);
            passwordToggle.setAttribute("aria-pressed", showPassword.toString());
            passwordToggle.setAttribute("title", label);
            passwordToggle.querySelector("[data-lucide]").setAttribute("data-lucide", showPassword ? "eye-off" : "eye");
            lucide.createIcons();
        });

        lucide.createIcons();
    </script>
</body>
</html>
