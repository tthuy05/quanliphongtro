@model IReadOnlyList<TroiSinhVien.Models.ViewModels.PropertyServiceListItem>
@{ Layout = "_ManagementLayout"; ViewData["Title"] = "Danh mục dịch vụ"; }
<div class="flex items-center justify-between"><div><h1 class="text-2xl font-bold">Danh mục dịch vụ</h1><p class="text-sm text-slate-500">Đơn giá hiện tại; hợp đồng giữ snapshot riêng.</p></div><a asp-action="Create" class="rounded-xl bg-indigo-600 px-4 py-2 text-white">Thêm dịch vụ</a></div>
<div class="mt-6 overflow-x-auto rounded-2xl bg-white"><table class="w-full text-sm"><thead class="bg-slate-50 text-left"><tr><th class="p-4">Khu trọ</th><th>Dịch vụ</th><th>Cách tính</th><th>Đơn giá</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr class="border-t"><td class="p-4">@x.BoardingHouseName</td><td><b>@x.Name</b><div class="text-xs text-slate-500">@x.Unit</div></td><td>@x.CalculationType</td><td>@x.UnitPrice.ToString("N0") ₫</td><td>@(x.IsActive ? "Hoạt động" : "Ngừng")</td><td><div class="flex gap-3"><a asp-action="Edit" asp-route-id="@x.Id" class="text-indigo-600">Sửa</a><form asp-action="SetActive" method="post"><input type="hidden" name="id" value="@x.Id"/><input type="hidden" name="isActive" value="@(!x.IsActive)"/><button class="@(x.IsActive ? "text-rose-600" : "text-emerald-600")">@(x.IsActive ? "Ngừng" : "Kích hoạt")</button></form></div></td></tr>}@if(Model.Count == 0){<tr><td colspan="6" class="p-10 text-center text-slate-500">Chưa có dịch vụ.</td></tr>}</tbody></table></div>
