@model TroiSinhVien.Models.InputModels.PropertyServiceInputModel
@{ Layout = "_ManagementLayout"; ViewData["Title"] = (ViewData["FormTitle"] as string) ?? "Thêm dịch vụ"; }
<h1 class="text-2xl font-bold">@ViewData["Title"]</h1>
<form method="post" class="mt-6 max-w-2xl space-y-4 rounded-2xl bg-white p-6"><div asp-validation-summary="All" class="text-rose-600"></div><label class="block">Khu trọ<select asp-for="BoardingHouseId" asp-items="ViewBag.Properties" class="mt-1 w-full rounded-lg border p-3"><option value="">Chọn khu trọ</option></select></label><label class="block">Tên<input asp-for="Name" class="mt-1 w-full rounded-lg border p-3"/></label><label class="block">Đơn vị<input asp-for="Unit" class="mt-1 w-full rounded-lg border p-3"/></label><label class="block">Cách tính<select asp-for="CalculationType" asp-items="Html.GetEnumSelectList<TroiSinhVien.Domain.Enums.ServiceCalculationType>()" class="mt-1 w-full rounded-lg border p-3"></select></label><label class="block">Đơn giá<input asp-for="UnitPrice" class="mt-1 w-full rounded-lg border p-3"/></label><button class="rounded-xl bg-indigo-600 px-5 py-3 text-white">Lưu</button></form>
