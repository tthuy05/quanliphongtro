@model TroiSinhVien.Models.ViewModels.OccupancyReportViewModel
@{ Layout="_ManagementLayout"; ViewData["Title"]="Báo cáo lấp đầy"; }
<div class="flex flex-wrap items-center justify-between gap-3"><h1 class="text-2xl font-bold">Báo cáo lấp đầy</h1><nav class="flex gap-3 text-sm"><a asp-action="Revenue">Doanh thu</a><a class="font-semibold text-indigo-600" asp-action="Occupancy">Lấp đầy</a><a asp-action="Debt">Công nợ</a></nav></div>
<partial name="_ReportFilter" model="Model" />
<div class="mt-5 grid gap-4 md:grid-cols-2 xl:grid-cols-3">@foreach(var row in Model.Rows){<article class="rounded-2xl bg-white p-5 shadow-sm"><h2 class="font-bold">@row.BoardingHouseName</h2><div class="mt-3 text-3xl font-black text-indigo-600">@row.OccupancyRate%</div><dl class="mt-4 grid grid-cols-2 gap-2 text-sm"><div><dt class="text-slate-500">Tổng phòng</dt><dd class="font-bold">@row.TotalRooms</dd></div><div><dt class="text-slate-500">Đang thuê</dt><dd class="font-bold">@row.OccupiedRooms</dd></div><div><dt class="text-slate-500">Còn trống</dt><dd class="font-bold">@row.AvailableRooms</dd></div><div><dt class="text-slate-500">Bảo trì</dt><dd class="font-bold">@row.MaintenanceRooms</dd></div></dl></article>}@if(Model.Rows.Count==0){<p class="text-slate-500">Chưa có dữ liệu phòng.</p>}</div>
