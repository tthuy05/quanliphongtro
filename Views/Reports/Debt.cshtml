@model TroiSinhVien.Models.ViewModels.DebtReportViewModel
@{ Layout="_ManagementLayout"; ViewData["Title"]="Báo cáo công nợ"; }
<div class="flex flex-wrap items-center justify-between gap-3"><div><h1 class="text-2xl font-bold">Báo cáo công nợ</h1><p class="text-sm text-slate-500">Tổng còn phải thu: @Model.Total.ToString("N0") ₫</p></div><nav class="flex gap-3 text-sm"><a asp-action="Revenue">Doanh thu</a><a asp-action="Occupancy">Lấp đầy</a><a class="font-semibold text-indigo-600" asp-action="Debt">Công nợ</a></nav></div>
<partial name="_ReportFilter" model="Model" />
<div class="mt-5 overflow-x-auto rounded-2xl bg-white"><table class="w-full text-sm"><thead class="bg-slate-50 text-left"><tr><th class="p-4">Khu trọ / phòng</th><th>Người thuê</th><th>Hóa đơn</th><th>Hạn</th><th>Quá hạn</th><th>Còn lại</th></tr></thead><tbody>@foreach(var row in Model.Rows){<tr class="border-t"><td class="p-4"><b>@row.BoardingHouseName</b><div>@row.RoomCode</div></td><td>@row.TenantName</td><td>@row.InvoiceNumber</td><td>@row.DueDate.ToString("dd/MM/yyyy")</td><td>@row.OverdueDays ngày</td><td class="font-bold text-rose-600">@row.RemainingAmount.ToString("N0") ₫</td></tr>}@if(Model.Rows.Count==0){<tr><td colspan="6" class="p-10 text-center text-slate-500">Không có công nợ đến ngày đã chọn.</td></tr>}</tbody></table></div>
