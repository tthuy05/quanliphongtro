@model TroiSinhVien.Models.ViewModels.RevenueReportViewModel
@{ Layout="_ManagementLayout"; ViewData["Title"]="Báo cáo doanh thu"; }
<div class="flex flex-wrap items-center justify-between gap-3"><div><h1 class="text-2xl font-bold">Báo cáo doanh thu</h1><p class="text-sm text-slate-500">Tổng thu đã xác nhận: @Model.Total.ToString("N0") ₫</p></div><nav class="flex gap-3 text-sm"><a class="font-semibold text-indigo-600" asp-action="Revenue">Doanh thu</a><a asp-action="Occupancy">Lấp đầy</a><a asp-action="Debt">Công nợ</a></nav></div>
<partial name="_ReportFilter" model="Model" />
<div class="mt-5 overflow-x-auto rounded-2xl bg-white"><table class="w-full text-sm"><thead class="bg-slate-50 text-left"><tr><th class="p-4">Khu trọ</th><th>Kỳ</th><th>Doanh thu</th></tr></thead><tbody>@foreach(var row in Model.Rows){<tr class="border-t"><td class="p-4 font-semibold">@row.BoardingHouseName</td><td>@row.Month/@row.Year</td><td>@row.Amount.ToString("N0") ₫</td></tr>}@if(Model.Rows.Count==0){<tr><td colspan="3" class="p-10 text-center text-slate-500">Không có thanh toán đã xác nhận trong kỳ.</td></tr>}</tbody></table></div>
