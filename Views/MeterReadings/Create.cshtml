@model TroiSinhVien.Models.InputModels.MeterReadingInputModel
@{ Layout = "_ManagementLayout"; var isEdit = ViewData["IsEdit"] as bool? == true; ViewData["Title"] = (ViewData["FormTitle"] as string) ?? "Ghi chỉ số"; }
<h1 class="text-2xl font-bold">@ViewData["Title"]</h1><form method="post" class="mt-6 max-w-xl space-y-4 rounded-2xl bg-white p-6"><div asp-validation-summary="All" class="text-rose-600"></div>@if(isEdit){<input asp-for="RoomId" type="hidden"/><input asp-for="MeterType" type="hidden"/><input asp-for="BillingMonth" type="hidden"/><input asp-for="BillingYear" type="hidden"/><div class="rounded-xl bg-slate-50 p-4 text-sm">Phòng #@Model.RoomId · @Model.MeterType · kỳ @Model.BillingMonth/@Model.BillingYear</div>}else{<label class="block">Phòng<select asp-for="RoomId" asp-items="ViewBag.Rooms" class="mt-1 w-full rounded-lg border p-3"><option value="">Chọn phòng đang thuê</option></select></label><label class="block">Loại<select asp-for="MeterType" asp-items="Html.GetEnumSelectList<TroiSinhVien.Domain.Enums.MeterType>()" class="mt-1 w-full rounded-lg border p-3"></select></label><div class="grid grid-cols-2 gap-4"><label>Tháng<input asp-for="BillingMonth" class="mt-1 w-full rounded-lg border p-3"/></label><label>Năm<input asp-for="BillingYear" class="mt-1 w-full rounded-lg border p-3"/></label></div>}<label class="block">Chỉ số mới<input asp-for="CurrentReading" class="mt-1 w-full rounded-lg border p-3"/></label>@if(isEdit){<p class="text-xs text-slate-500">Không thể sửa khi chỉ số này hoặc kỳ kế tiếp đã được dùng trong hóa đơn.</p>}<button class="rounded-xl bg-indigo-600 px-5 py-3 text-white">Lưu</button></form>
