@model IReadOnlyList<TroiSinhVien.Models.ViewModels.MeterReadingListItem>
@{ Layout = "_ManagementLayout"; ViewData["Title"] = "Điện nước"; }
<div class="flex justify-between"><h1 class="text-2xl font-bold">Chỉ số điện nước</h1><a href="/MeterReadings/Create" class="rounded-xl bg-indigo-600 px-4 py-2 text-white">Ghi chỉ số</a></div><div class="mt-6 overflow-x-auto rounded-2xl bg-white"><table class="w-full text-sm"><thead class="bg-slate-50 text-left"><tr><th class="p-4">Phòng</th><th>Loại</th><th>Kỳ</th><th>Chỉ số cũ</th><th>Chỉ số mới</th><th>Tiêu thụ</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr class="border-t"><td class="p-4 font-bold">@x.RoomCode</td><td>@x.MeterType</td><td>@x.BillingMonth/@x.BillingYear</td><td>@x.PreviousReading</td><td>@x.CurrentReading</td><td>@x.Consumption</td><td><a asp-action="Edit" asp-route-id="@x.Id" class="text-indigo-600">Sửa</a></td></tr>}@if(Model.Count == 0){<tr><td colspan="7" class="p-10 text-center text-slate-500">Chưa có chỉ số.</td></tr>}</tbody></table></div>
