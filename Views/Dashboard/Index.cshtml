<!-- Views/Dashboard/Index.cshtml -->
@model TroiSinhVien.Models.ViewModels.Dashboard.DashboardPageViewModel
@{
    ViewData["Title"] = "Bảng điều khiển";
}

<div class="px-4 sm:px-6 py-6 max-w-7xl mx-auto space-y-6 select-none font-sans">
    
    <!-- DASHBOARD HEADER ZONE -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Hệ thống quản lý nhà trọ</h1>
            <p class="text-sm text-slate-500 mt-1">Tổng quan thông số vận hành và doanh thu bất động sản</p>
        </div>

        <div class="flex items-center gap-3 self-start sm:self-center">
            @{ var activeParts = Model.ActiveMonth.Replace("Tháng", "").Trim().Split('/'); var activeMonth = int.Parse(activeParts[0]); var activeYear = int.Parse(activeParts[1]); var activeDate = new DateTime(activeYear, activeMonth, 1); }
            <form method="get"><input type="hidden" name="propertyId" value="@Model.ActivePropertyId" /><label class="sr-only" for="dashboard-month">Kỳ báo cáo</label><select id="dashboard-month" name="month" onchange="this.form.submit()" class="h-10 rounded-xl border border-slate-200 bg-white px-3 text-sm font-semibold text-slate-700">
                @for (var i = 0; i < 12; i++) { var period = activeDate.AddMonths(-i); var value = $"{period.Month}/{period.Year}"; if (i == 0) { <option value="@value" selected>Tháng @value</option> } else { <option value="@value">Tháng @value</option> } }
            </select></form>
            <a href="/Rooms/Create" class="h-10 px-4 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-bold text-sm shadow-md shadow-indigo-600/10 hover:shadow-indigo-600/20 active:scale-97 transition-all flex items-center gap-2">
                <i data-lucide="plus-circle" class="w-4 h-4"></i>
                <span class="hidden sm:inline">Thêm phòng</span>
            </a>
        </div>
    </div>

    @if (Model.Properties.Count == 0)
    {
        <div class="rounded-2xl border border-slate-100 bg-white p-12 text-center shadow-sm"><i data-lucide="building-2" class="mx-auto h-10 w-10 text-slate-300"></i><h2 class="mt-4 text-lg font-bold">Chưa có khu trọ</h2><p class="mt-2 text-sm text-slate-500">Tạo khu trọ đầu tiên để bắt đầu quản lý phòng và hợp đồng.</p><a href="/BoardingHouses/Create" class="mt-5 inline-flex rounded-xl bg-indigo-600 px-4 py-2 text-sm font-bold text-white">Tạo khu trọ</a></div>
    }
    else
    {
    <div class="space-y-6">
        
        <!-- Welcome Hero Panel -->
        <section aria-label="Chào mừng" class="reveal-on-scroll is-revealed">
            @await Html.PartialAsync("Partials/_DashboardHero")
        </section>

        <!-- Operational Statistics Cards Grid -->
        <section aria-label="Thông số nhanh" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 reveal-on-scroll is-revealed">
            @foreach (var stat in Model.Stats)
            {
                @await Html.PartialAsync("_StatCard", stat)
            }
        </section>

        <!-- Charts Dashboard Grid Section -->
        <section aria-label="Biểu đồ phân tích" class="grid grid-cols-1 lg:grid-cols-3 gap-6 reveal-on-scroll is-revealed">
            <!-- Line/Area Chart Panel (2/3 width on desktop) -->
            <div class="lg:col-span-2">
                @await Html.PartialAsync("Partials/_RevenueOverview")
            </div>
            <!-- Donut Chart Panel (1/3 width on desktop) -->
            <div class="lg:col-span-1">
                @await Html.PartialAsync("Partials/_OccupancyOverview")
            </div>
        </section>

        <!-- Lower Grid Area: Operations and Timelines -->
        <section aria-label="Chi tiết vận hành" class="grid grid-cols-1 lg:grid-cols-3 gap-6 reveal-on-scroll is-revealed">
            <!-- Left Data Panels (2/3 width) -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Recent Invoices table -->
                @await Html.PartialAsync("Partials/_RecentInvoices")

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Overdue payments -->
                    @await Html.PartialAsync("Partials/_OverduePayments")
                    
                    <!-- Expiring leases -->
                    @await Html.PartialAsync("Partials/_ExpiringContracts")
                </div>

                <!-- Maintenance request list -->
                @await Html.PartialAsync("Partials/_MaintenanceRequests")
            </div>

            <!-- Right Activity and Shortcut Panels (1/3 width) -->
            <div class="lg:col-span-1 space-y-6">
                <!-- Quick actions shortcuts grid -->
                @await Html.PartialAsync("Partials/_QuickActions")

                <!-- Timeline updates feed -->
                @await Html.PartialAsync("Partials/_ActivityTimeline")
            </div>
        </section>
        
    </div>
    }

</div>

@section Scripts {
    <!-- Register chart and viewport observers -->
    <script src="~/js/dashboard/hero-motion.js" defer></script>
    <script src="~/js/dashboard/counters.js" defer></script>
    <script src="~/js/dashboard/charts.js" defer></script>
    <script src="~/js/dashboard/viewport-motion.js" defer></script>
    
    <!-- Render chart datasets coordinates inside JS variables -->
    <script>
        window.chartRevenueData = @Html.Raw(Json.Serialize(Model.RevenueChart.DataPoints));
        window.chartOccupancyData = @Html.Raw(Json.Serialize(Model.OccupancyChart));
    </script>
}
