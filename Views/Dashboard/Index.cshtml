<!-- Views/Dashboard/Index.cshtml -->
@model TroiSinhVien.Models.ViewModels.Dashboard.DashboardPageViewModel
@{
    ViewData["Title"] = "Bảng điều khiển";
}

<div class="px-4 sm:px-6 py-6 max-w-7xl mx-auto space-y-6 select-none font-sans">
    
    <!-- DASHBOARD HEADER ZONE -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Hệ thống quản lý nhà trọ</h1>
            <p class="text-sm text-slate-500 mt-1">Tổng quan thông số vận hành và doanh thu bất động sản</p>
        </div>

        <div class="flex items-center gap-3 self-start sm:self-center">
            <!-- Filter Month Dropdown -->
            <div class="relative" x-data="{ open: false }" @@click.away="open = false">
                <button @@click="open = !open"
                        class="h-10 flex items-center gap-2 px-3.5 bg-white border border-slate-200 hover:border-slate-300 hover:bg-slate-50 rounded-xl text-slate-700 font-semibold text-sm transition-all focus:outline-none focus:ring-2 focus:ring-indigo-600">
                    <i data-lucide="calendar" class="w-4 h-4 text-slate-400"></i>
                    <span x-text="currentMonth">@Model.ActiveMonth</span>
                    <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400"></i>
                </button>
                <div class="absolute right-0 mt-2 w-48 bg-white border border-slate-100 rounded-2xl shadow-xl z-30 overflow-hidden"
                     x-show="open"
                     x-transition:enter="transition ease-out duration-200"
                     x-transition:enter-start="opacity-0 scale-95"
                     x-transition:enter-end="opacity-100 scale-100"
                     x-transition:leave="transition ease-in duration-150"
                     x-transition:leave-start="opacity-100 scale-100"
                     x-transition:leave-end="opacity-0 scale-95"
                     style="display: none;"
                >
                    <div class="p-1.5 space-y-0.5">
                        <button @@click="currentMonth = 'Tháng 7/2026'; open = false;" class="w-full text-left px-3.5 py-2 rounded-lg text-sm font-medium hover:bg-slate-50 text-slate-700 hover:text-indigo-600">Tháng 7/2026</button>
                        <button @@click="currentMonth = 'Tháng 6/2026'; open = false;" class="w-full text-left px-3.5 py-2 rounded-lg text-sm font-medium hover:bg-slate-50 text-slate-700 hover:text-indigo-600">Tháng 6/2026</button>
                        <button @@click="currentMonth = 'Tháng 5/2026'; open = false;" class="w-full text-left px-3.5 py-2 rounded-lg text-sm font-medium hover:bg-slate-50 text-slate-700 hover:text-indigo-600">Tháng 5/2026</button>
                    </div>
                </div>
            </div>

            <!-- New Property Button Trigger -->
            <button class="h-10 px-4 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-bold text-sm shadow-md shadow-indigo-600/10 hover:shadow-indigo-600/20 active:scale-97 transition-all flex items-center gap-2">
                <i data-lucide="plus-circle" class="w-4 h-4"></i>
                <span class="hidden sm:inline">Thêm phòng</span>
            </button>
        </div>
    </div>

    <!-- DYNAMIC STATES CONTROLLER -->
    
    <!-- State 1: Skeleton Loader -->
    <div x-show="pageState === 'loading'" style="display: none;" class="space-y-6">
        @await Html.PartialAsync("_SkeletonLoader")
    </div>

    <!-- State 2: Empty Data State -->
    <div x-show="pageState === 'empty'" style="display: none;" class="space-y-6">
        @await Html.PartialAsync("_EmptyState")
    </div>

    <!-- State 3: Normal Load Render (Mock Data) -->
    <div x-show="pageState === 'normal'" class="space-y-6">
        
        <!-- Welcome Hero Panel -->
        <section aria-label="Chào mừng" class="reveal-on-scroll is-revealed">
            @await Html.PartialAsync("Partials/_DashboardHero")
        </section>

        <!-- Operational Statistics Cards Grid -->
        <section aria-label="Thông số nhanh" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 reveal-on-scroll is-revealed">
            @foreach (var stat in Model.Stats)
            {
                @await Html.PartialAsync("_StatCard", stat)
            }
        </section>

        <!-- Charts Dashboard Grid Section -->
        <section aria-label="Biểu đồ phân tích" class="grid grid-cols-1 lg:grid-cols-3 gap-6 reveal-on-scroll is-revealed">
            <!-- Line/Area Chart Panel (2/3 width on desktop) -->
            <div class="lg:col-span-2">
                @await Html.PartialAsync("Partials/_RevenueOverview")
            </div>
            <!-- Donut Chart Panel (1/3 width on desktop) -->
            <div class="lg:col-span-1">
                @await Html.PartialAsync("Partials/_OccupancyOverview")
            </div>
        </section>

        <!-- Lower Grid Area: Operations and Timelines -->
        <section aria-label="Chi tiết vận hành" class="grid grid-cols-1 lg:grid-cols-3 gap-6 reveal-on-scroll is-revealed">
            <!-- Left Data Panels (2/3 width) -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Recent Invoices table -->
                @await Html.PartialAsync("Partials/_RecentInvoices")

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Overdue payments -->
                    @await Html.PartialAsync("Partials/_OverduePayments")
                    
                    <!-- Expiring leases -->
                    @await Html.PartialAsync("Partials/_ExpiringContracts")
                </div>

                <!-- Maintenance request list -->
                @await Html.PartialAsync("Partials/_MaintenanceRequests")
            </div>

            <!-- Right Activity and Shortcut Panels (1/3 width) -->
            <div class="lg:col-span-1 space-y-6">
                <!-- Quick actions shortcuts grid -->
                @await Html.PartialAsync("Partials/_QuickActions")

                <!-- Timeline updates feed -->
                @await Html.PartialAsync("Partials/_ActivityTimeline")
            </div>
        </section>
        
    </div>

</div>

@section Scripts {
    <!-- Register chart and viewport observers -->
    <script src="~/js/dashboard/hero-motion.js" defer></script>
    <script src="~/js/dashboard/counters.js" defer></script>
    <script src="~/js/dashboard/charts.js" defer></script>
    <script src="~/js/dashboard/viewport-motion.js" defer></script>
    
    <!-- Render chart datasets coordinates inside JS variables -->
    <script>
        window.chartRevenueData = @Html.Raw(Json.Serialize(Model.RevenueChart.DataPoints));
        window.chartOccupancyData = @Html.Raw(Json.Serialize(Model.OccupancyChart));
    </script>
}
