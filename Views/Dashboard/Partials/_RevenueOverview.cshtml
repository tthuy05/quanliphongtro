<!-- _RevenueOverview.cshtml -->
@model TroiSinhVien.Models.ViewModels.Dashboard.DashboardPageViewModel

<div class="bg-white border border-slate-100 rounded-2xl p-5 shadow-sm select-none flex flex-col justify-between h-full">
    <!-- Panel Header -->
    <div class="flex items-center justify-between gap-3 shrink-0">
        <div>
            <h3 class="text-base font-extrabold text-slate-800">Biểu đồ doanh thu & chi phí</h3>
            <p class="text-xs text-slate-500 mt-0.5">Xu hướng luồng tiền 6 tháng gần nhất</p>
        </div>
        
        <!-- Period Switcher Dropdown (Pure UI mockup) -->
        <div class="relative" x-data="{ open: false }" @@click.away="open = false">
            <button @@click="open = !open"
                    class="h-8.5 px-3 bg-slate-50 hover:bg-slate-100 border border-slate-200 rounded-xl text-slate-700 font-semibold text-xs transition-colors flex items-center gap-1.5 focus:outline-none">
                <span>Nửa năm nay</span>
                <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-slate-400"></i>
            </button>
            <div class="absolute right-0 mt-1.5 w-40 bg-white border border-slate-100 rounded-xl shadow-lg z-20 overflow-hidden"
                 x-show="open"
                 x-transition:enter="transition ease-out duration-200"
                 x-transition:enter-start="opacity-0 scale-95"
                 x-transition:enter-end="opacity-100 scale-100"
                 x-transition:leave="transition ease-in duration-150"
                 x-transition:leave-start="opacity-100 scale-100"
                 x-transition:leave-end="opacity-0 scale-95"
                 style="display: none;"
            >
                <div class="p-1 space-y-0.5">
                    <button @@click="open = false" class="w-full text-left px-3 py-1.5 rounded-lg text-xxs font-bold hover:bg-slate-50 text-slate-700 hover:text-indigo-600">6 tháng gần đây</button>
                    <button @@click="open = false" class="w-full text-left px-3 py-1.5 rounded-lg text-xxs font-bold hover:bg-slate-50 text-slate-700 hover:text-indigo-600">Theo năm 2026</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Brief Financial Summary Indicators Row -->
    <div class="grid grid-cols-3 gap-4 my-5 py-3 border-y border-slate-50 shrink-0">
        <div>
            <div class="text-xxs font-bold text-slate-400 uppercase">Tổng thu</div>
            <div class="text-lg font-black text-indigo-600 mt-0.5">58,4M <span class="text-xs font-bold">₫</span></div>
        </div>
        <div>
            <div class="text-xxs font-bold text-slate-400 uppercase">Tổng chi</div>
            <div class="text-lg font-black text-slate-600 mt-0.5">17,2M <span class="text-xs font-bold">₫</span></div>
        </div>
        <div>
            <div class="text-xxs font-bold text-slate-400 uppercase">Lợi nhuận</div>
            <div class="text-lg font-black text-emerald-600 mt-0.5">41,2M <span class="text-xs font-bold">₫</span></div>
        </div>
    </div>

    <!-- Chart Canvas Container (Aspect ratio preserved for CLS prevention) -->
    <div class="relative flex-1 w-full min-h-[220px]">
        <canvas id="revenueLineChart" class="w-full h-full"></canvas>
    </div>

    <!-- Screen Reader Fallback Data (WCAG Accessibility compliance) -->
    <div class="sr-only">
        <h4>Số liệu doanh thu và chi phí 6 tháng gần nhất</h4>
        <table>
            <thead>
                <tr>
                    <th>Tháng</th>
                    <th>Doanh thu</th>
                    <th>Chi phí</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pt in Model.RevenueChart.DataPoints)
                {
                    <tr>
                        <td>@pt.Month</td>
                        <td>@pt.Revenue triệu ₫</td>
                        <td>@pt.Expense triệu ₫</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>
