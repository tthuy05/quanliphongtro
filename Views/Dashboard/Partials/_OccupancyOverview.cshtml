<!-- _OccupancyOverview.cshtml -->
@model TroiSinhVien.Models.ViewModels.Dashboard.DashboardPageViewModel

<div class="bg-white border border-slate-100 rounded-2xl p-5 shadow-sm select-none flex flex-col justify-between h-full">
    <!-- Panel Header -->
    <div class="shrink-0">
        <h3 class="text-base font-extrabold text-slate-800">Tỷ lệ lấp đầy</h3>
        <p class="text-xs text-slate-500 mt-0.5">Trạng thái phòng thực tế thời gian thực</p>
    </div>

    <!-- Doughnut Canvas Area (Inside aspect-square container to prevent shift layout) -->
    <div class="relative w-full aspect-square max-w-[190px] mx-auto my-6 flex items-center justify-center">
        <canvas id="occupancyDonutChart" class="w-full h-full z-0"></canvas>
        
        <!-- Center absolute percentage text -->
        <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none select-none z-10">
            <span class="text-3xl font-extrabold text-slate-800 tracking-tight" id="occupancy-center-percent">@Model.OccupancyChart.OccupancyPercentage%</span>
            <span class="text-xxs font-bold text-slate-400 uppercase mt-0.5">Đã thuê</span>
        </div>
    </div>

    <!-- Details Slices Legend Indicator rows -->
    <div class="space-y-2.5 pt-4 border-t border-slate-50 shrink-0">
        <div class="flex items-center justify-between text-xs font-semibold">
            <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 shrink-0"></span>
                <span class="text-slate-500">Đang thuê</span>
            </div>
            <span class="text-slate-800" id="occupancy-occupied-count">@Model.OccupancyChart.OccupiedCount phòng</span>
        </div>
        
        <div class="flex items-center justify-between text-xs font-semibold">
            <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-slate-300 shrink-0"></span>
                <span class="text-slate-500">Còn trống</span>
            </div>
            <span class="text-slate-800" id="occupancy-available-count">@Model.OccupancyChart.AvailableCount phòng</span>
        </div>

        <div class="flex items-center justify-between text-xs font-semibold">
            <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-amber-500 shrink-0"></span>
                <span class="text-slate-500">Bảo trì</span>
            </div>
            <span class="text-slate-800" id="occupancy-maintenance-count">@Model.OccupancyChart.MaintenanceCount phòng</span>
        </div>
    </div>

    <!-- Management short summary note -->
    <div class="mt-4 p-3 bg-slate-50 rounded-xl flex gap-2.5 items-start shrink-0">
        <i data-lucide="info" class="w-4 h-4 text-indigo-600 shrink-0 mt-0.5"></i>
        <p class="text-xxs font-medium text-slate-500 leading-normal">
            <span class="font-bold text-slate-700 text-xxs block mb-0.5">Lời khuyên quản trị:</span>
            <span>Hiệu suất lấp đầy đang tốt. Cân nhắc sửa nhanh phòng trống để khai thác nốt.</span>
        </p>
    </div>
</div>
