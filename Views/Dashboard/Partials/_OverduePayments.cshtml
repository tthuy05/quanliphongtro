<!-- _OverduePayments.cshtml -->
@model TroiSinhVien.Models.ViewModels.Dashboard.DashboardPageViewModel

<div class="bg-white border border-slate-100 rounded-2xl p-5 shadow-sm select-none flex flex-col justify-between h-full">
    <!-- Header -->
    <div class="flex items-center justify-between gap-3 mb-4 shrink-0">
        <div>
            <h3 class="text-base font-extrabold text-slate-800">Công nợ quá hạn</h3>
            <p class="text-xs text-slate-500 mt-0.5">Danh sách các phòng chưa đóng tiền</p>
        </div>
        <i data-lucide="alert-triangle" class="w-5 h-5 text-rose-500 shrink-0"></i>
    </div>

    <!-- Data Rows -->
    <div class="flex-1 overflow-y-auto space-y-3.5 max-h-[300px] scrollbar-thin">
        @if (Model.OverduePayments.Count == 0)
        {
            <div class="py-12 text-center text-slate-400">
                <i data-lucide="check-circle" class="w-8 h-8 mx-auto text-emerald-500 mb-2"></i>
                <p class="text-xs">Tuyệt vời! Không có nợ quá hạn</p>
            </div>
        }
        else
        {
            @foreach (var debt in Model.OverduePayments)
            {
                <div class="p-3 bg-slate-50 rounded-xl hover:bg-slate-100 border border-slate-100/30 transition-all flex items-center justify-between gap-3 group">
                    <div class="min-w-0">
                        <div class="flex items-baseline gap-2">
                            <span class="text-sm font-extrabold text-slate-800">Phòng @debt.RoomCode</span>
                            <span class="inline-flex px-1.5 py-0.2 rounded bg-rose-50 text-rose-600 border border-rose-100 text-xxs font-bold">Trễ @debt.OverdueDays ngày</span>
                        </div>
                        <div class="text-xs text-slate-500 truncate mt-1">Khách: <span class="font-bold text-slate-600">@debt.TenantName</span></div>
                        <div class="text-sm font-extrabold text-rose-600 mt-1.5">@debt.AmountFormatted</div>
                    </div>
                    
                    <!-- Call Action link -->
                    <button class="px-3 py-1.5 bg-rose-50 border border-rose-100 text-rose-700 hover:bg-rose-100 hover:text-rose-800 font-bold text-xxs rounded-lg transition-colors flex items-center gap-1.5 shrink-0 select-none">
                        <i data-lucide="message-square" class="w-3.5 h-3.5"></i>
                        <span>Báo nợ</span>
                    </button>
                </div>
            }
        }
    </div>
</div>
