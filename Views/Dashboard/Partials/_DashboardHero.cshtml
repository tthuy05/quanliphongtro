<!-- _DashboardHero.cshtml -->
@model TroiSinhVien.Models.ViewModels.Dashboard.DashboardPageViewModel

<div class="relative bg-slate-900 rounded-3xl overflow-hidden shadow-lg border border-slate-800 text-white min-h-[300px] flex flex-col md:flex-row items-stretch select-none">
    
    <!-- Ambient Light Background Glow (CSS animated overlay) -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute -top-[10%] -left-[10%] w-[50%] h-[50%] rounded-full bg-indigo-500/10 blur-[80px] hero-ambient-active"></div>
        <div class="absolute -bottom-[10%] -right-[10%] w-[40%] h-[40%] rounded-full bg-blue-500/10 blur-[80px] hero-ambient-active"></div>
    </div>

    <!-- Textual Greeting Column (Left: ~55-60% width) -->
    <div class="relative z-10 flex-1 p-6 sm:p-8 flex flex-col justify-between md:max-w-[60%] lg:max-w-[58%]">
        <!-- Date header info -->
        <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-white/10 text-white text-xxs font-bold uppercase tracking-wider">
                <i data-lucide="sparkles" class="w-3 h-3 text-indigo-300"></i>
                <span>Trực quan vận hành</span>
            </span>
            <span class="text-xs text-slate-400 font-medium">@DateTime.Now.ToString("dd MMMM, yyyy", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))</span>
        </div>

        <!-- Greeting summary -->
        <div class="mt-6 md:mt-8 space-y-3.5">
            <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
                @Model.Hero.Greeting, <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-300 to-indigo-100">@Model.Hero.OwnerName</span>!
            </h2>
            <p class="text-base text-slate-300 font-medium max-w-md">
                @Model.Hero.SummaryText
            </p>
        </div>

        <!-- Mini indicators row -->
        <div class="grid grid-cols-2 gap-4 mt-8 pt-6 border-t border-white/5 max-w-sm">
            <div class="flex items-start gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-indigo-500/15 flex items-center justify-center text-indigo-300 shrink-0">
                    <i data-lucide="key-round" class="w-4.5 h-4.5"></i>
                </div>
                <div>
                    <div class="text-xxs font-bold text-slate-400 uppercase">Tỷ lệ lấp đầy</div>
                    <div class="text-sm font-bold text-white mt-0.5">@Model.Hero.OccupiedCount/@Model.Hero.TotalRoomsCount phòng <span class="text-xs text-indigo-300 font-medium">(@Model.Hero.OccupancyPercentage%)</span></div>
                </div>
            </div>
            <div class="flex items-start gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-emerald-500/15 flex items-center justify-center text-emerald-300 shrink-0">
                    <i data-lucide="banknote" class="w-4.5 h-4.5"></i>
                </div>
                <div>
                    <div class="text-xxs font-bold text-slate-400 uppercase">Doanh thu tháng</div>
                    <div class="text-sm font-bold text-white mt-0.5">@Model.Hero.MonthlyRevenueFormatted</div>
                </div>
            </div>
        </div>

        <!-- CTA Action Buttons row -->
        <div class="flex flex-wrap items-center gap-3 mt-8">
            <button class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 active:scale-97 text-white font-bold text-sm rounded-xl transition-all shadow-md shadow-indigo-600/15 flex items-center gap-2">
                <i data-lucide="receipt" class="w-4.5 h-4.5"></i>
                <span>Tạo hóa đơn tháng này</span>
            </button>
            <button class="px-5 py-2.5 bg-white/10 hover:bg-white/15 active:scale-97 text-white font-bold text-sm rounded-xl border border-white/10 hover:border-white/20 transition-all flex items-center gap-2">
                <i data-lucide="plus" class="w-4.5 h-4.5"></i>
                <span>Thêm phòng mới</span>
            </button>
        </div>
    </div>

    <!-- Landscape Image Column with gradient blending masks (Right: ~40-45% width) -->
    <div class="relative flex-1 min-h-[220px] md:min-h-auto overflow-hidden md:max-w-[40%] lg:max-w-[42%] flex items-center justify-center md:border-l md:border-white/5 select-none"
         x-data="{ zoomActive: true, hoverMotion: false }"
         @@mouseenter="hoverMotion = true"
         @@mouseleave="hoverMotion = false"
         id="hero-interactive-image-container"
    >
        <!-- Background static image fallback or panning animation -->
        <div class="absolute inset-0 w-full h-full overflow-hidden water-reflection z-0">
            <img src="~/images/dashboard/dashboard-hero-landscape.png" 
                 alt="Trọ Sinh Viên Landscape View" 
                 class="w-full h-full object-cover transition-transform duration-[12000ms] ease-out origin-center"
                 :class="hoverMotion ? 'scale-105' : 'hero-zoom-active'"
                 id="hero-landscape-image"
                 style="object-position: center 65%;"
            />
        </div>

        <!-- Smooth horizontal blend overlay gradient to transition textual areas -->
        <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-slate-900/40 to-transparent pointer-events-none z-10 hidden md:block"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/30 to-transparent pointer-events-none z-10 md:hidden"></div>

        <!-- Visual Image details overlay badge (Watermark is kept untouched at bottom right edge natively) -->
        <div class="absolute top-4 right-4 z-10">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-900/70 backdrop-blur-md text-slate-300 text-xxs font-medium border border-white/5 select-none">
                <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
                <span>Thừa Thiên Huế, Việt Nam</span>
            </span>
        </div>
    </div>

</div>
