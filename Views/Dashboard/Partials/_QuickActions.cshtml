<!-- _QuickActions.cshtml -->
@model TroiSinhVien.Models.ViewModels.Dashboard.DashboardPageViewModel

<div class="bg-white border border-slate-100 rounded-2xl p-5 shadow-sm select-none">
    <!-- Header -->
    <div class="mb-4">
        <h3 class="text-base font-extrabold text-slate-800">Thao tác nhanh</h3>
        <p class="text-xs text-slate-500 mt-0.5">Các chức năng quản trị thường dùng nhất</p>
    </div>

    <!-- Actions Grid (2 columns on standard layout) -->
    <div class="grid grid-cols-2 gap-3.5">
        @foreach (var action in Model.QuickActions)
        {
            <a href="@action.ActionRoute"
               class="p-3 bg-slate-50 hover:bg-indigo-50 border border-slate-100/50 hover:border-indigo-100 rounded-2xl flex flex-col gap-2.5 transition-all duration-300 group hover:translate-y-[-2px] hover:shadow-sm"
               title="@action.Description">
                <!-- Icon container -->
                <div class="w-8.5 h-8.5 rounded-xl bg-white group-hover:bg-white text-slate-500 group-hover:text-indigo-600 flex items-center justify-center transition-colors duration-300 shadow-sm shadow-slate-100 shrink-0">
                    <i data-lucide="@action.IconName" class="w-4.5 h-4.5"></i>
                </div>
                <div>
                    <div class="text-xs font-bold text-slate-800 group-hover:text-indigo-900 transition-colors leading-tight">@action.Label</div>
                    <div class="text-[10px] text-slate-400 font-medium truncate mt-1 leading-none">@action.Description</div>
                </div>
            </a>
        }
    </div>
</div>
