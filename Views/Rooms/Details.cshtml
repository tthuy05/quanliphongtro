@model TroiSinhVien.Models.ViewModels.RoomDetailsViewModel
@{ Layout = "_ManagementLayout"; ViewData["Title"] = $"Phòng {Model.Room.RoomCode}"; }
<div class="flex flex-wrap justify-between gap-3"><div><a asp-action="Index" class="text-sm text-indigo-600">← Phòng</a><h1 class="mt-2 text-2xl font-bold">@Model.Room.BoardingHouseName · @Model.Room.RoomCode</h1><p class="mt-1 text-slate-500">@Model.Room.Status</p></div><a asp-action="Edit" asp-route-id="@Model.Room.Id" class="rounded-xl border px-4 py-2 self-start">Chỉnh sửa</a></div><section class="mt-6 rounded-2xl bg-white p-6"><dl class="grid gap-4 text-sm sm:grid-cols-3"><div><dt class="text-slate-500">Giá thuê</dt><dd class="font-semibold">@Model.Room.MonthlyRent.ToString("N0") ₫</dd></div><div><dt class="text-slate-500">Tiền cọc</dt><dd class="font-semibold">@Model.DepositAmount.ToString("N0") ₫</dd></div><div><dt class="text-slate-500">Diện tích / sức chứa</dt><dd>@Model.Area m² · @Model.Room.MaximumOccupants người</dd></div></dl><p class="mt-4 text-sm text-slate-600">@(Model.Description ?? "Không có mô tả.")</p></section><div class="mt-6 grid gap-6 lg:grid-cols-2"><section class="rounded-2xl bg-white p-6"><h2 class="font-bold">Người đang ở</h2><ul class="mt-3 space-y-2 text-sm">@foreach(var name in Model.CurrentTenants){<li>@name</li>}@if(Model.CurrentTenants.Count == 0){<li class="text-slate-500">Phòng đang trống.</li>}</ul></section><section class="rounded-2xl bg-white p-6"><h2 class="font-bold">Lịch sử hợp đồng</h2><div class="mt-3 space-y-2">@foreach(var contract in Model.Contracts){<a href="/Contracts/Details/@contract.Id" class="block rounded-xl bg-slate-50 p-3 text-sm"><b>@contract.ContractCode</b><div class="text-slate-500">@contract.StartDate – @contract.EndDate · @contract.Status</div></a>}@if(Model.Contracts.Count == 0){<p class="text-sm text-slate-500">Chưa có hợp đồng.</p>}</div></section></div>
