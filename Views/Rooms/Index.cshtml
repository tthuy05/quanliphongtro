@model TroiSinhVien.Models.ViewModels.PagedResult<TroiSinhVien.Models.ViewModels.RoomListItem>
@{ Layout = "_ManagementLayout"; ViewData["Title"] = "Phòng"; }
<div class="flex items-center justify-between"><h1 class="text-2xl font-bold">Phòng</h1><a asp-action="Create" class="rounded-xl bg-indigo-600 px-4 py-2 text-white">Thêm phòng</a></div><form method="get" class="mt-4 flex flex-wrap gap-2"><input name="search" value="@Context.Request.Query["search"]" placeholder="Tìm mã hoặc tên phòng" class="rounded-xl border px-4 py-2"/><select name="status" class="rounded-xl border px-3" asp-items="Html.GetEnumSelectList<TroiSinhVien.Domain.Enums.RoomStatus>()"><option value="">Mọi trạng thái</option></select><button class="rounded-xl bg-slate-800 px-4 text-white">Tìm</button></form><div class="mt-5 overflow-x-auto rounded-2xl bg-white"><table class="w-full text-sm"><thead class="bg-slate-50 text-left"><tr><th class="p-4">Phòng</th><th>Khu trọ</th><th>Tầng</th><th>Giá thuê</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var x in Model.Items){<tr class="border-t"><td class="p-4 font-bold"><a asp-action="Details" asp-route-id="@x.Id" class="text-indigo-600">@x.RoomCode</a></td><td>@x.BoardingHouseName</td><td>@x.Floor</td><td>@x.MonthlyRent.ToString("N0") ₫</td><td>@x.Status</td><td><div class="flex gap-3"><a asp-action="Edit" asp-route-id="@x.Id" class="text-indigo-600">Sửa</a>@if(x.Status != TroiSinhVien.Domain.Enums.RoomStatus.Inactive){<form asp-action="Deactivate" method="post"><input type="hidden" name="id" value="@x.Id"/><button class="text-rose-600">Ngừng</button></form>}</div></td></tr>}@if(Model.Items.Count == 0){<tr><td colspan="6" class="p-10 text-center text-slate-500">Không có phòng phù hợp.</td></tr>}</tbody></table></div>@if(Model.TotalPages > 1){<nav class="mt-4 flex gap-2" aria-label="Phân trang">@for(var p = 1; p <= Model.TotalPages; p++){<a asp-route-page="@p" class="rounded-lg px-3 py-2 @(p == Model.Page ? "bg-indigo-600 text-white" : "bg-white")">@p</a>}</nav>}
