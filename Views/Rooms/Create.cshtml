@model TroiSinhVien.Models.InputModels.RoomInputModel
@{ Layout="_ManagementLayout"; ViewData["Title"] = ViewData["FormTitle"] ?? "Thêm phòng"; }
<h1 class="text-2xl font-bold">@(ViewData["FormTitle"] ?? "Thêm phòng")</h1>
<form method="post" class="mt-6 grid max-w-3xl gap-4 rounded-2xl bg-white p-6 sm:grid-cols-2"><div asp-validation-summary="All" class="text-rose-600 sm:col-span-2"></div><label>Khu trọ<select asp-for="BoardingHouseId" asp-items="ViewBag.Properties" class="mt-1 w-full rounded-lg border p-3"><option value="">Chọn khu trọ</option></select></label><label>Mã phòng<input asp-for="RoomCode" class="mt-1 w-full rounded-lg border p-3"/></label><label>Tên phòng<input asp-for="RoomName" class="mt-1 w-full rounded-lg border p-3"/></label><label>Tầng<input asp-for="Floor" class="mt-1 w-full rounded-lg border p-3"/></label><label>Diện tích<input asp-for="Area" class="mt-1 w-full rounded-lg border p-3"/></label><label>Số người tối đa<input asp-for="MaximumOccupants" class="mt-1 w-full rounded-lg border p-3"/></label><label>Giá thuê<input asp-for="MonthlyRent" class="mt-1 w-full rounded-lg border p-3"/></label><label>Tiền cọc<input asp-for="DepositAmount" class="mt-1 w-full rounded-lg border p-3"/></label><label>Trạng thái<select asp-for="Status" asp-items="Html.GetEnumSelectList<TroiSinhVien.Domain.Enums.RoomStatus>()" class="mt-1 w-full rounded-lg border p-3"></select></label><label class="sm:col-span-2">Mô tả<textarea asp-for="Description" class="mt-1 w-full rounded-lg border p-3"></textarea></label><button class="rounded-xl bg-indigo-600 px-5 py-3 text-white sm:col-span-2">Lưu phòng</button></form>
