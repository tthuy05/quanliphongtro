<!-- _MobileNavigation.cshtml -->
<div class="fixed inset-y-0 left-0 z-50 flex w-full max-w-xs flex-col bg-slate-900 border-r border-slate-850"
     x-show="mobileSidebarOpen"
     x-transition:enter="transition ease-in-out duration-350 transform"
     x-transition:enter-start="-translate-x-full"
     x-transition:enter-end="translate-x-0"
     x-transition:leave="transition ease-in-out duration-250 transform"
     x-transition:leave-start="translate-x-0"
     x-transition:leave-end="-translate-x-full"
     style="display: none;"
     x-trap.noscroll.inert="mobileSidebarOpen"
>
    <!-- Brand Header -->
    <div class="h-16 flex items-center justify-between px-6 border-b border-slate-800 shrink-0">
        <div class="flex items-center gap-3">
            <div class="flex items-center justify-center w-9 h-9 rounded-xl bg-gradient-to-tr from-indigo-500 to-indigo-600 text-white shrink-0 shadow-md shadow-indigo-500/10">
                <i data-lucide="home" class="w-5 h-5"></i>
            </div>
            <span class="text-base font-extrabold text-white tracking-wide uppercase">
                Trọ <span class="text-indigo-400">Sinh Viên</span>
            </span>
        </div>
        <!-- Close Menu Button -->
        <button @@click="mobileSidebarOpen = false"
                class="p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-600"
                aria-label="Đóng menu điều hướng">
            <i data-lucide="x" class="w-5 h-5"></i>
        </button>
    </div>

    <!-- Navigation links list -->
    <nav class="flex-1 overflow-y-auto py-6 px-4 space-y-2">
        <!-- Dashboard Home (Active) -->
        <a href="#" class="flex items-center gap-3.5 px-4 py-3 rounded-xl font-medium transition-all duration-200 bg-indigo-600 text-white shadow-md shadow-indigo-600/10"
           @@click="mobileSidebarOpen = false">
            <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
            <span>Tổng quan</span>
        </a>

        <!-- Properties -->
        <a href="#" class="flex items-center gap-3.5 px-4 py-3 rounded-xl font-medium text-slate-400 hover:bg-slate-800 hover:text-slate-100 transition-colors"
           @@click="mobileSidebarOpen = false">
            <i data-lucide="building" class="w-5 h-5"></i>
            <span>Khu trọ</span>
        </a>

        <!-- Rooms -->
        <a href="#" class="flex items-center gap-3.5 px-4 py-3 rounded-xl font-medium text-slate-400 hover:bg-slate-800 hover:text-slate-100 transition-colors"
           @@click="mobileSidebarOpen = false">
            <i data-lucide="key-round" class="w-5 h-5"></i>
            <span>Phòng</span>
        </a>

        <!-- Tenants -->
        <a href="#" class="flex items-center gap-3.5 px-4 py-3 rounded-xl font-medium text-slate-400 hover:bg-slate-800 hover:text-slate-100 transition-colors"
           @@click="mobileSidebarOpen = false">
            <i data-lucide="users" class="w-5 h-5"></i>
            <span>Người thuê</span>
        </a>

        <!-- Contracts -->
        <a href="#" class="flex items-center gap-3.5 px-4 py-3 rounded-xl font-medium text-slate-400 hover:bg-slate-800 hover:text-slate-100 transition-colors"
           @@click="mobileSidebarOpen = false">
            <i data-lucide="file-signature" class="w-5 h-5"></i>
            <span>Hợp đồng</span>
        </a>

        <!-- Utilities -->
        <a href="#" class="flex items-center gap-3.5 px-4 py-3 rounded-xl font-medium text-slate-400 hover:bg-slate-800 hover:text-slate-100 transition-colors"
           @@click="mobileSidebarOpen = false">
            <i data-lucide="zap" class="w-5 h-5"></i>
            <span>Điện và nước</span>
        </a>

        <!-- Invoices -->
        <a href="#" class="flex items-center gap-3.5 px-4 py-3 rounded-xl font-medium text-slate-400 hover:bg-slate-800 hover:text-slate-100 transition-colors"
           @@click="mobileSidebarOpen = false">
            <i data-lucide="receipt" class="w-5 h-5"></i>
            <span>Hóa đơn</span>
        </a>

        <!-- Payments -->
        <a href="#" class="flex items-center gap-3.5 px-4 py-3 rounded-xl font-medium text-slate-400 hover:bg-slate-800 hover:text-slate-100 transition-colors"
           @@click="mobileSidebarOpen = false">
            <i data-lucide="credit-card" class="w-5 h-5"></i>
            <span>Thanh toán</span>
        </a>

        <!-- Maintenance -->
        <a href="#" class="flex items-center gap-3.5 px-4 py-3 rounded-xl font-medium text-slate-400 hover:bg-slate-800 hover:text-slate-100 transition-colors"
           @@click="mobileSidebarOpen = false">
            <i data-lucide="wrench" class="w-5 h-5"></i>
            <span>Sửa chữa</span>
        </a>

        <!-- Reports -->
        <a href="#" class="flex items-center gap-3.5 px-4 py-3 rounded-xl font-medium text-slate-400 hover:bg-slate-800 hover:text-slate-100 transition-colors"
           @@click="mobileSidebarOpen = false">
            <i data-lucide="bar-chart-3" class="w-5 h-5"></i>
            <span>Báo cáo</span>
        </a>

        <!-- Notifications -->
        <a href="#" class="flex items-center gap-3.5 px-4 py-3 rounded-xl font-medium text-slate-400 hover:bg-slate-800 hover:text-slate-100 transition-colors"
           @@click="mobileSidebarOpen = false">
            <i data-lucide="bell" class="w-5 h-5"></i>
            <span>Thông báo</span>
        </a>
    </nav>

    <!-- Footer Settings -->
    <div class="p-6 border-t border-slate-800">
        <a href="#" class="flex items-center gap-3.5 px-4 py-3 rounded-xl font-medium text-slate-400 hover:bg-slate-800 hover:text-slate-100 transition-colors"
           @@click="mobileSidebarOpen = false">
            <i data-lucide="settings" class="w-5 h-5"></i>
            <span>Cài đặt cấu hình</span>
        </a>
    </div>
</div>
