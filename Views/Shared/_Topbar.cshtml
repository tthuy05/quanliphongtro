<!-- _Topbar.cshtml -->
<header class="h-16 flex items-center justify-between px-4 sm:px-6 bg-white border-b border-slate-100 sticky top-0 z-20 shadow-sm shrink-0">
    <div class="flex items-center gap-4">
        <!-- Mobile Sidebar Open Toggle -->
        <button @@click="mobileSidebarOpen = true"
                class="lg:hidden p-2 rounded-lg text-slate-500 hover:bg-slate-50 hover:text-slate-700 transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-600"
                aria-label="Mở menu điều hướng">
            <i data-lucide="menu" class="w-6 h-6"></i>
        </button>

        <!-- Selected Boarding House context dropdown -->
        @await Html.PartialAsync("_PropertySelector")
    </div>

    <!-- Search box trigger -->
    <div class="hidden md:flex items-center flex-1 max-w-md mx-8">
        <button @@click="searchOpen = true"
                class="w-full h-10 flex items-center justify-between px-3.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 hover:border-slate-300 rounded-xl text-slate-400 hover:text-slate-500 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-indigo-600 text-sm">
            <div class="flex items-center gap-2.5">
                <i data-lucide="search" class="w-4.5 h-4.5 text-slate-400"></i>
                <span>Tìm kiếm phòng, người thuê, hợp đồng...</span>
            </div>
            <kbd class="hidden sm:inline-block px-1.5 py-0.5 text-xs font-semibold text-slate-500 bg-white border border-slate-200 rounded shadow-sm">Ctrl + K</kbd>
        </button>
    </div>

    <!-- Right Side Header Controls -->
    <div class="flex items-center gap-3">
        
        <!-- UI DEMO STATE CONTROL TOGGLE (To showcase all UI conditions requested) -->
        <div class="relative shrink-0 flex items-center bg-slate-50 p-1 rounded-xl border border-slate-100 text-xs font-medium"
             x-data="{ showStatePicker: false }">
            <span class="hidden sm:inline text-slate-400 px-2">Trạng thái Demo:</span>
            <select x-model="pageState"
                    class="bg-transparent text-slate-700 hover:text-indigo-600 font-semibold focus:outline-none pr-6 cursor-pointer border-none py-1">
                <option value="normal">Bình thường (Mock)</option>
                <option value="loading">Đang tải (Skeleton)</option>
                <option value="empty">Danh sách trống (Empty)</option>
            </select>
        </div>

        <!-- Search button for mobile -->
        <button @@click="searchOpen = true"
                class="md:hidden p-2 rounded-xl text-slate-500 hover:bg-slate-50 hover:text-slate-700 transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-600"
                aria-label="Tìm kiếm">
            <i data-lucide="search" class="w-5 h-5"></i>
        </button>

        <!-- Notification Panel Control -->
        @await Html.PartialAsync("_NotificationPanel")

        <!-- User profile action dropdown menu -->
        @await Html.PartialAsync("_UserMenu")
    </div>
</header>
