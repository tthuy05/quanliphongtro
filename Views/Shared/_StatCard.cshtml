<!-- _StatCard.cshtml -->
@model TroiSinhVien.Models.ViewModels.Dashboard.DashboardStatViewModel

@{
    // Calculate color class for trend values
    string trendColorClass = "text-slate-500 bg-slate-50 border-slate-200/50";
    string trendIcon = "minus";

    if (Model.TrendDirection == "up")
    {
        trendColorClass = "text-emerald-700 bg-emerald-50 border-emerald-100";
        trendIcon = "trending-up";
    }
    else if (Model.TrendDirection == "down")
    {
        trendColorClass = "text-rose-700 bg-rose-50 border-rose-100";
        trendIcon = "trending-down";
    }
}

<div class="bg-white border border-slate-100 rounded-2xl p-5 shadow-sm hover:shadow-md hover:translate-y-[-2px] transition-all duration-300 flex flex-col justify-between select-none relative overflow-hidden group">
    
    <!-- Top Row containing icon and title -->
    <div class="flex items-center justify-between gap-3">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">@Model.Title</span>
        <div class="w-9 h-9 rounded-xl bg-slate-50 group-hover:bg-indigo-50 text-slate-400 group-hover:text-indigo-600 flex items-center justify-center transition-colors duration-300 shrink-0">
            <i data-lucide="@Model.IconName" class="w-4.5 h-4.5"></i>
        </div>
    </div>

    <!-- Value Row (With count-up placeholder data-target attribute for JS counters) -->
    <div class="mt-4 flex items-baseline gap-2">
        @{
            // Separate numbers and text units
            string rawValue = Model.Value;
            string numericString = "";
            string textUnit = "";
            
            // Extract starting numbers (including decimal dots or commas)
            int charIndex = 0;
            while (charIndex < rawValue.Length && (char.IsDigit(rawValue[charIndex]) || rawValue[charIndex] == '.' || rawValue[charIndex] == ','))
            {
                numericString += rawValue[charIndex];
                charIndex++;
            }
            textUnit = rawValue.Substring(charIndex);
        }

        @if (!string.IsNullOrEmpty(numericString))
        {
            <span class="text-2xl font-extrabold text-slate-800 tracking-tight"
                  data-counter-target="@numericString"
                  data-counter-unit="@textUnit">
                @Model.Value
            </span>
        }
        else
        {
            <span class="text-2xl font-extrabold text-slate-800 tracking-tight">
                @Model.Value
            </span>
        }
    </div>

    <!-- Bottom Trend Row & optional Sparklines -->
    <div class="mt-4 pt-4 border-t border-slate-50 flex items-center justify-between gap-3 shrink-0">
        
        <!-- Sparkline Rendering (SVG dynamic generator) -->
        @if (Model.SparklineData != null && Model.SparklineData.Count > 0)
        {
            <div class="w-20 h-8 flex items-center">
                @{
                    var points = Model.SparklineData;
                    double min = points[0];
                    double max = points[0];
                    foreach (var p in points)
                    {
                        if (p < min) min = p;
                        if (p > max) max = p;
                    }
                    double range = max - min;
                    if (range == 0) range = 1.0;

                    // Normalize points to SVG viewBox: width=80, height=28
                    string polyPoints = "";
                    for (int i = 0; i < points.Count; i++)
                    {
                        double x = (double)i / (points.Count - 1) * 76 + 2;
                        double y = 28 - ((points[i] - min) / range * 24 + 2);
                        polyPoints += $"{x.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)},{y.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)} ";
                    }
                }
                <svg class="w-full h-full overflow-visible" viewBox="0 0 80 28" aria-hidden="true">
                    <!-- Subtle shadow/gradient pathway -->
                    <polyline fill="none"
                              stroke="@(Model.TrendDirection == "down" ? "var(--color-danger)" : "var(--color-primary)")"
                              stroke-width="1.8"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              points="@polyPoints" />
                </svg>
            </div>
        }

        <!-- Trend Percentage pill badge -->
        <div class="flex items-center gap-1 text-xxs font-bold px-2 py-0.5 rounded-full border @trendColorClass shrink-0">
            @if (Model.TrendDirection != "neutral")
            {
                <i data-lucide="@trendIcon" class="w-3 h-3"></i>
            }
            <span>@(Model.TrendDirection == "neutral" ? "0%" : $"{Model.TrendPercentage}%")</span>
        </div>

        <!-- Trend caption text -->
        <span class="text-xxs text-slate-400 text-right truncate flex-1">@Model.TrendText</span>
    </div>

</div>
