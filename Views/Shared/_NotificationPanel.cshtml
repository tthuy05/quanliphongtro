<!-- _NotificationPanel.cshtml -->
@model TroiSinhVien.Models.ViewModels.Dashboard.DashboardPageViewModel

<div class="relative" x-data="{ open: false }" @@click.away="open = false">
    <!-- Bell icon trigger -->
    <button @@click="open = !open"
            class="p-2.5 rounded-xl border border-slate-100 hover:bg-slate-50 transition-all duration-200 relative focus:outline-none focus:ring-2 focus:ring-indigo-600 @(Model.Notifications.Any(n => n.IsUnread) ? "pulse-indicator" : "")"
            aria-label="Xem thông báo"
            :aria-expanded="open.toString()">
        <i data-lucide="bell" class="w-5 h-5 text-slate-500"></i>
    </button>

    <!-- Dropdown list -->
    <div class="absolute right-0 mt-2 w-96 bg-white border border-slate-100 rounded-2xl shadow-xl z-50 overflow-hidden flex flex-col"
         x-show="open"
         x-transition:enter="transition ease-out duration-200 transform"
         x-transition:enter-start="opacity-0 scale-95 translate-y-[-8px]"
         x-transition:enter-end="opacity-100 scale-100 translate-y-0"
         x-transition:leave="transition ease-in duration-150 transform"
         x-transition:leave-start="opacity-100 scale-100 translate-y-0"
         x-transition:leave-end="opacity-0 scale-95 translate-y-[-8px]"
         style="display: none;"
    >
        <!-- Header -->
        <div class="px-4 py-3.5 border-b border-slate-100 bg-slate-50 flex items-center justify-between shrink-0">
            <span class="text-sm font-bold text-slate-800">Thông báo</span>
            <form asp-controller="Notifications" asp-action="MarkAllRead" method="post"><button class="text-xs font-semibold text-indigo-600 hover:text-indigo-700 transition-colors">Đánh dấu tất cả đã đọc</button></form>
        </div>

        <!-- Notification List -->
        <div class="flex-1 overflow-y-auto max-h-[360px] p-2 space-y-1 scrollbar-thin">
            @if (Model.Notifications.Count == 0)
            {
                <div class="py-12 text-center text-slate-400">
                    <i data-lucide="bell-off" class="w-8 h-8 mx-auto text-slate-300 mb-2"></i>
                    <p class="text-xs">Không có thông báo nào mới</p>
                </div>
            }
            else
            {
                @foreach (var notif in Model.Notifications)
                {
                    <a href="@(notif.LinkUrl ?? "/Notifications")" class="flex gap-3 p-3 rounded-xl hover:bg-slate-50 transition-colors relative group @(notif.IsUnread ? "bg-indigo-50/20" : "")">
                        <!-- Icon representation -->
                        <div class="w-8.5 h-8.5 rounded-lg flex items-center justify-center shrink-0 
                                    @(notif.Type == "danger" ? "bg-rose-50 text-rose-600" : 
                                      notif.Type == "warning" ? "bg-amber-50 text-amber-600" : 
                                      notif.Type == "success" ? "bg-emerald-50 text-emerald-600" : 
                                      "bg-sky-50 text-sky-600")">
                            <i data-lucide="@notif.IconName" class="w-4 h-4"></i>
                        </div>

                        <div class="flex-1 min-w-0">
                            <div class="flex items-start justify-between gap-2">
                                <div class="text-sm font-bold text-slate-800 leading-tight @(notif.IsUnread ? "pr-4" : "")">@notif.Title</div>
                                @if (notif.IsUnread)
                                {
                                    <span class="w-2 h-2 bg-indigo-600 rounded-full shrink-0 mt-1 absolute right-4 top-4"></span>
                                }
                            </div>
                            <div class="text-xs text-slate-400 mt-1 leading-normal">@notif.Description</div>
                            <div class="text-xxs font-medium text-slate-400 mt-1.5 flex items-center gap-1">
                                <i data-lucide="clock" class="w-3 h-3 text-slate-400"></i>
                                <span>@notif.TimeText</span>
                            </div>
                        </div>
                    </a>
                }
            }
        </div>

        <!-- Footer -->
        <a href="/Notifications" class="px-4 py-3 bg-slate-50 border-t border-slate-100 text-center text-xs font-semibold text-slate-500 hover:text-indigo-600 transition-colors shrink-0">
            Xem tất cả thông báo
        </a>
    </div>
</div>
