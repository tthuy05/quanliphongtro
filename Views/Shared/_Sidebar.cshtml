<!-- _Sidebar.cshtml -->
<aside class="hidden lg:flex flex-col shrink-0 bg-slate-900 border-r border-slate-800 transition-all duration-300 relative text-slate-400 select-none z-30"
       :class="sidebarCollapsed ? 'w-[72px]' : 'w-[260px]'">
    
    <!-- Logo & Brand Header -->
    <div class="h-16 flex items-center border-b border-slate-800 transition-all duration-300"
         :class="sidebarCollapsed ? 'justify-center px-0' : 'justify-between px-6'">
        <div class="flex items-center gap-3 overflow-hidden">
            <div class="flex items-center justify-center w-9 h-9 rounded-xl bg-gradient-to-tr from-indigo-500 to-indigo-600 text-white shrink-0 shadow-md shadow-indigo-500/10">
                <i data-lucide="home" class="w-5 h-5"></i>
            </div>
            <span class="text-base font-extrabold text-white tracking-wide uppercase transition-opacity duration-200"
                  x-show="!sidebarCollapsed"
                  x-transition:enter="transition ease-out duration-200"
                  x-transition:enter-start="opacity-0"
                  x-transition:enter-end="opacity-100">
                Trọ <span class="text-indigo-400">Sinh Viên</span>
            </span>
        </div>
        
        <!-- Sidebar Collapse Toggle Button -->
        <button @@click="sidebarCollapsed = !sidebarCollapsed"
                class="p-1.5 rounded-lg text-slate-500 hover:text-slate-200 hover:bg-slate-800 transition-colors"
                x-show="!sidebarCollapsed">
            <i data-lucide="chevron-left" class="w-4 h-4"></i>
        </button>
    </div>

    <!-- Navigation links list -->
    <nav class="flex-1 overflow-y-auto py-6 px-3 space-y-1.5 scrollbar-thin">
        <!-- Dashboard Home (Active) -->
        <a href="/Dashboard" class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-medium transition-all duration-200 bg-indigo-600 text-white shadow-md shadow-indigo-600/10 hover:shadow-indigo-600/20 group"
           :class="sidebarCollapsed ? 'justify-center' : ''"
           title="Tổng quan">
            <i data-lucide="layout-dashboard" class="w-5 h-5 shrink-0 transition-transform duration-200 group-hover:scale-110"></i>
            <span x-show="!sidebarCollapsed" class="whitespace-nowrap">Tổng quan</span>
        </a>

        <!-- Properties -->
        <a href="/BoardingHouses" class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-medium transition-all duration-200 hover:bg-slate-800 hover:text-slate-100 group"
           :class="sidebarCollapsed ? 'justify-center' : ''"
           title="Khu trọ">
            <i data-lucide="building" class="w-5 h-5 shrink-0 transition-transform duration-200 group-hover:scale-110"></i>
            <span x-show="!sidebarCollapsed" class="whitespace-nowrap">Khu trọ</span>
        </a>

        <!-- Rooms -->
        <a href="/Rooms" class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-medium transition-all duration-200 hover:bg-slate-800 hover:text-slate-100 group"
           :class="sidebarCollapsed ? 'justify-center' : ''"
           title="Phòng">
            <i data-lucide="key-round" class="w-5 h-5 shrink-0 transition-transform duration-200 group-hover:scale-110"></i>
            <span x-show="!sidebarCollapsed" class="whitespace-nowrap">Phòng</span>
        </a>

        <!-- Tenants -->
        <a href="/Tenants" class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-medium transition-all duration-200 hover:bg-slate-800 hover:text-slate-100 group"
           :class="sidebarCollapsed ? 'justify-center' : ''"
           title="Người thuê">
            <i data-lucide="users" class="w-5 h-5 shrink-0 transition-transform duration-200 group-hover:scale-110"></i>
            <span x-show="!sidebarCollapsed" class="whitespace-nowrap">Người thuê</span>
        </a>

        <!-- Contracts -->
        <a href="/Contracts" class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-medium transition-all duration-200 hover:bg-slate-800 hover:text-slate-100 group"
           :class="sidebarCollapsed ? 'justify-center' : ''"
           title="Hợp đồng">
            <i data-lucide="file-signature" class="w-5 h-5 shrink-0 transition-transform duration-200 group-hover:scale-110"></i>
            <span x-show="!sidebarCollapsed" class="whitespace-nowrap">Hợp đồng</span>
        </a>

        <a href="/PropertyServices" class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-medium transition-all duration-200 hover:bg-slate-800 hover:text-slate-100 group"
           :class="sidebarCollapsed ? 'justify-center' : ''" title="Dịch vụ">
            <i data-lucide="list-plus" class="w-5 h-5 shrink-0"></i>
            <span x-show="!sidebarCollapsed" class="whitespace-nowrap">Dịch vụ</span>
        </a>

        <!-- Utilities -->
        <a href="/MeterReadings?propertyId=0" class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-medium transition-all duration-200 hover:bg-slate-800 hover:text-slate-100 group"
           :class="sidebarCollapsed ? 'justify-center' : ''"
           title="Điện và nước">
            <i data-lucide="zap" class="w-5 h-5 shrink-0 transition-transform duration-200 group-hover:scale-110"></i>
            <span x-show="!sidebarCollapsed" class="whitespace-nowrap">Điện và nước</span>
        </a>

        <!-- Invoices -->
        <a href="/Invoices" class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-medium transition-all duration-200 hover:bg-slate-800 hover:text-slate-100 group"
           :class="sidebarCollapsed ? 'justify-center' : ''"
           title="Hóa đơn">
            <i data-lucide="receipt" class="w-5 h-5 shrink-0 transition-transform duration-200 group-hover:scale-110"></i>
            <span x-show="!sidebarCollapsed" class="whitespace-nowrap">Hóa đơn</span>
        </a>

        <!-- Payments -->
        <a href="/Payments" class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-medium transition-all duration-200 hover:bg-slate-800 hover:text-slate-100 group"
           :class="sidebarCollapsed ? 'justify-center' : ''"
           title="Thanh toán">
            <i data-lucide="credit-card" class="w-5 h-5 shrink-0 transition-transform duration-200 group-hover:scale-110"></i>
            <span x-show="!sidebarCollapsed" class="whitespace-nowrap">Thanh toán</span>
        </a>

        <!-- Maintenance -->
        <a href="/Maintenance" class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-medium transition-all duration-200 hover:bg-slate-800 hover:text-slate-100 group"
           :class="sidebarCollapsed ? 'justify-center' : ''"
           title="Sửa chữa">
            <i data-lucide="wrench" class="w-5 h-5 shrink-0 transition-transform duration-200 group-hover:scale-110"></i>
            <span x-show="!sidebarCollapsed" class="whitespace-nowrap">Sửa chữa</span>
        </a>

        <!-- Reports -->
        <a href="/Reports/Revenue" class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-medium transition-all duration-200 hover:bg-slate-800 hover:text-slate-100 group"
           :class="sidebarCollapsed ? 'justify-center' : ''"
           title="Báo cáo">
            <i data-lucide="bar-chart-3" class="w-5 h-5 shrink-0 transition-transform duration-200 group-hover:scale-110"></i>
            <span x-show="!sidebarCollapsed" class="whitespace-nowrap">Báo cáo</span>
        </a>

        <!-- Notifications -->
        <a href="/Notifications" class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-medium transition-all duration-200 hover:bg-slate-800 hover:text-slate-100 group"
           :class="sidebarCollapsed ? 'justify-center' : ''"
           title="Thông báo">
            <i data-lucide="bell" class="w-5 h-5 shrink-0 transition-transform duration-200 group-hover:scale-110"></i>
            <span x-show="!sidebarCollapsed" class="whitespace-nowrap">Thông báo</span>
        </a>
    </nav>

    <!-- Sidebar Footer / Settings -->
    <div class="p-3 border-t border-slate-800 flex flex-col items-center">
        <!-- Settings link -->
        <a href="/Account/Settings" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl font-medium transition-all duration-200 hover:bg-slate-800 hover:text-slate-100 group"
           :class="sidebarCollapsed ? 'justify-center' : ''"
           title="Cài đặt">
            <i data-lucide="settings" class="w-5 h-5 shrink-0 transition-transform duration-200 group-hover:spin-slow"></i>
            <span x-show="!sidebarCollapsed" class="whitespace-nowrap">Cài đặt</span>
        </a>
        
        <!-- Mini Toggle Button when Collapsed -->
        <button @@click="sidebarCollapsed = !sidebarCollapsed"
                class="mt-4 p-1.5 rounded-lg text-slate-500 hover:text-slate-200 hover:bg-slate-800 transition-colors"
                x-show="sidebarCollapsed">
            <i data-lucide="chevron-right" class="w-4 h-4"></i>
        </button>
    </div>
</aside>
