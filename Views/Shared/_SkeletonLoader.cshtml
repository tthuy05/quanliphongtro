<!-- _SkeletonLoader.cshtml -->
<div class="space-y-6 font-sans select-none">
    
    <!-- 1. Hero Shimmer Panel -->
    <div class="bg-white border border-slate-100 rounded-3xl p-6 sm:p-8 h-[220px] flex items-center justify-between gap-6 overflow-hidden relative">
        <div class="space-y-4 flex-1">
            <div class="w-1/3 h-8 rounded-lg shimmer"></div>
            <div class="w-1/2 h-5 rounded-lg shimmer"></div>
            <div class="w-1/4 h-5 rounded-lg shimmer"></div>
        </div>
        <div class="hidden md:block w-[35%] h-full rounded-2xl shimmer"></div>
    </div>

    <!-- 2. Statistics Grid Shimmer Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        @for (int i = 0; i < 5; i++)
        {
            <div class="bg-white border border-slate-100 rounded-2xl p-5 space-y-4 h-[120px] flex flex-col justify-between">
                <div class="flex items-center justify-between">
                    <div class="w-1/2 h-4 rounded shimmer"></div>
                    <div class="w-8 h-8 rounded-xl shimmer"></div>
                </div>
                <div class="w-2/3 h-7 rounded-lg shimmer"></div>
                <div class="w-1/3 h-3 rounded shimmer"></div>
            </div>
        }
    </div>

    <!-- 3. Dual Charts Shimmer Cards -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 bg-white border border-slate-100 rounded-2xl p-5 h-[320px] flex flex-col justify-between">
            <div class="flex items-center justify-between">
                <div class="w-1/4 h-5 rounded-lg shimmer"></div>
                <div class="w-20 h-7 rounded-lg shimmer"></div>
            </div>
            <div class="flex-1 w-full mt-6 rounded-xl shimmer"></div>
        </div>
        <div class="lg:col-span-1 bg-white border border-slate-100 rounded-2xl p-5 h-[320px] flex flex-col items-center justify-between">
            <div class="w-2/3 h-5 rounded-lg shimmer self-start"></div>
            <div class="w-36 h-36 rounded-full shimmer my-6"></div>
            <div class="w-full h-12 rounded-xl shimmer"></div>
        </div>
    </div>

</div>
