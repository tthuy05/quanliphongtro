<!-- _SearchCommand.cshtml -->
<div class="fixed inset-0 z-50 flex items-start justify-center pt-[10vh] px-4"
     x-show="searchOpen"
     style="display: none;"
     x-trap.noscroll.inert="searchOpen"
>
    <!-- Modal Backdrop Blur -->
    <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm"
         x-show="searchOpen"
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-200"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         @@click="searchOpen = false">
    </div>

    <!-- Search Dialog Box -->
    <div class="relative w-full max-w-xl bg-white border border-slate-100 rounded-2xl shadow-2xl overflow-hidden flex flex-col z-10"
         x-show="searchOpen"
         x-transition:enter="transition ease-out duration-300 transform"
         x-transition:enter-start="opacity-0 scale-95 -translate-y-4"
         x-transition:enter-end="opacity-100 scale-100 translate-y-0"
         x-transition:leave="transition ease-in duration-250 transform"
         x-transition:leave-start="opacity-100 scale-100 translate-y-0"
         x-transition:leave-end="opacity-0 scale-95 -translate-y-4"
    >
        <!-- Search Input Header -->
        <div class="flex items-center gap-3 px-4 py-3.5 border-b border-slate-100 shrink-0">
            <i data-lucide="search" class="w-5 h-5 text-slate-400"></i>
            <input type="text"
                   placeholder="Tìm kiếm phòng, người thuê, hóa đơn..."
                   class="w-full text-base bg-transparent text-slate-800 placeholder-slate-400 border-none outline-none focus:ring-0"
                   x-init="$watch('searchOpen', value => { if(value) { $nextTick(() => $el.focus()); } })"
            >
            <button @@click="searchOpen = false"
                    class="p-1 rounded-lg text-slate-400 hover:bg-slate-50 hover:text-slate-600 transition-colors">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>

        <!-- Search Results List -->
        <div class="flex-1 overflow-y-auto max-h-[50vh] p-3 space-y-1.5 scrollbar-thin">
            <div class="px-3 py-1 text-xxs font-bold text-slate-400 uppercase tracking-wider">Gợi ý tìm kiếm</div>
            
            <a href="#" class="flex items-center justify-between p-3 rounded-xl hover:bg-slate-50 transition-colors group">
                <div class="flex items-center gap-3 min-w-0">
                    <div class="w-8.5 h-8.5 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0">
                        <i data-lucide="door-closed" class="w-4 h-4"></i>
                    </div>
                    <div class="min-w-0">
                        <div class="text-sm font-semibold text-slate-800">Phòng A101</div>
                        <div class="text-xs text-slate-400 truncate mt-0.5">Tầng 1 • Người thuê: Nguyễn Văn Anh</div>
                    </div>
                </div>
                <div class="text-xs text-slate-400 group-hover:text-indigo-600 transition-colors flex items-center gap-1 shrink-0">
                    <span>Xem chi tiết</span>
                    <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                </div>
            </a>

            <a href="#" class="flex items-center justify-between p-3 rounded-xl hover:bg-slate-50 transition-colors group">
                <div class="flex items-center gap-3 min-w-0">
                    <div class="w-8.5 h-8.5 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
                        <i data-lucide="users" class="w-4 h-4"></i>
                    </div>
                    <div class="min-w-0">
                        <div class="text-sm font-semibold text-slate-800">Trần Thị Bình</div>
                        <div class="text-xs text-slate-400 truncate mt-0.5">Phòng A102 • SĐT: 0987.xxx.234</div>
                    </div>
                </div>
                <div class="text-xs text-slate-400 group-hover:text-indigo-600 transition-colors flex items-center gap-1 shrink-0">
                    <span>Xem chi tiết</span>
                    <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                </div>
            </a>

            <a href="#" class="flex items-center justify-between p-3 rounded-xl hover:bg-slate-50 transition-colors group">
                <div class="flex items-center gap-3 min-w-0">
                    <div class="w-8.5 h-8.5 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center shrink-0">
                        <i data-lucide="alert-circle" class="w-4 h-4"></i>
                    </div>
                    <div class="min-w-0">
                        <div class="text-sm font-semibold text-slate-800">Hóa đơn quá hạn phòng A102</div>
                        <div class="text-xs text-slate-400 truncate mt-0.5">Trị giá: 2.800.000 ₫ • Trễ: 1 ngày</div>
                    </div>
                </div>
                <div class="text-xs text-slate-400 group-hover:text-indigo-600 transition-colors flex items-center gap-1 shrink-0">
                    <span>Xử lý nợ</span>
                    <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                </div>
            </a>
        </div>

        <!-- Search Footer Keyboard shortcuts description -->
        <div class="px-4 py-3 bg-slate-50 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400 shrink-0 select-none">
            <div class="flex gap-4">
                <span class="flex items-center gap-1"><kbd class="px-1 bg-white border rounded shadow-sm font-sans font-bold">↑↓</kbd> Di chuyển</span>
                <span class="flex items-center gap-1"><kbd class="px-1 bg-white border rounded shadow-sm font-sans font-bold">Enter</kbd> Chọn</span>
            </div>
            <span>Ấn <kbd class="px-1 bg-white border rounded shadow-sm font-sans font-bold">ESC</kbd> để đóng</span>
        </div>
    </div>
</div>
