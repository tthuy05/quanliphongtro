<!-- _EmptyState.cshtml -->
<div class="py-16 px-4 bg-white border border-slate-100 rounded-3xl shadow-sm text-center max-w-xl mx-auto space-y-5 select-none font-sans">
    
    <!-- Outer visual circle -->
    <div class="w-16 h-16 rounded-full bg-slate-50 border border-slate-100 flex items-center justify-center mx-auto text-slate-400">
        <i data-lucide="folder-open" class="w-8 h-8"></i>
    </div>

    <!-- Details description -->
    <div class="space-y-1">
        <h3 class="text-base font-bold text-slate-800">Không tìm thấy dữ liệu vận hành</h3>
        <p class="text-xs text-slate-400 max-w-sm mx-auto leading-normal">
            Không có ghi nhận hóa đơn, báo cáo doanh thu hay hợp đồng nào trong kỳ xem xét này. Vui lòng nhập dữ liệu để bắt đầu.
        </p>
    </div>

    <!-- Active CTA action button -->
    <button @@click="pageState = 'normal'; showToast('Đang khôi phục dữ liệu ban đầu...', 'info');"
            class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl shadow-md shadow-indigo-600/10 hover:shadow-indigo-600/20 active:scale-97 transition-all flex items-center gap-1.5 mx-auto">
        <i data-lucide="refresh-cw" class="w-3.5 h-3.5 spin-slow"></i>
        <span>Nạp dữ liệu mẫu</span>
    </button>

</div>
