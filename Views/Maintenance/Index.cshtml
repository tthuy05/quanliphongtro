@model IReadOnlyList<TroiSinhVien.Models.ViewModels.MaintenanceListItem>
@{ Layout = "_ManagementLayout"; ViewData["Title"] = "Sửa chữa"; }
<div class="flex items-center justify-between">
    <div><h1 class="text-2xl font-bold">Yêu cầu sửa chữa</h1><p class="mt-1 text-sm text-slate-500">Theo dõi trao đổi và tiến độ xử lý theo từng yêu cầu.</p></div>
</div>
<div class="mt-6 space-y-3">
    @if (Model.Count == 0) { <div class="rounded-2xl bg-white p-8 text-center text-slate-500">Chưa có yêu cầu sửa chữa.</div> }
    @foreach (var x in Model)
    {
        <a asp-action="Details" asp-route-id="@x.Id" class="block rounded-2xl bg-white p-5 shadow-sm transition hover:shadow-md">
            <div class="flex flex-wrap items-start justify-between gap-3">
                <div><div class="font-bold">@x.RoomCode · @x.Title</div><div class="mt-1 text-sm text-slate-500">@x.TenantName · @x.Category · @x.Priority · @x.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div></div>
                <span class="rounded-full bg-slate-100 px-3 py-1 text-sm">@x.Status</span>
            </div>
        </a>
    }
</div>
