@model TroiSinhVien.Models.InputModels.ContractInputModel
@{ Layout="_ManagementLayout"; ViewData["Title"]="Tạo hợp đồng"; }
<h1 class="text-2xl font-bold">Tạo hợp đồng nháp</h1><form method="post" class="mt-6 grid max-w-3xl gap-4 rounded-2xl bg-white p-6 sm:grid-cols-2"><div asp-validation-summary="All" class="text-rose-600 sm:col-span-2"></div><label>Mã hợp đồng<input asp-for="ContractCode" class="mt-1 w-full rounded-lg border p-3"/></label><label>Phòng<select asp-for="RoomId" asp-items="ViewBag.Rooms" class="mt-1 w-full rounded-lg border p-3"><option value="">Chọn phòng còn trống</option></select></label><label>Người đại diện<select asp-for="RepresentativeTenantId" asp-items="ViewBag.Tenants" class="mt-1 w-full rounded-lg border p-3"><option value="">Chọn người thuê</option></select></label><label>Hạn thanh toán<input asp-for="PaymentDueDay" class="mt-1 w-full rounded-lg border p-3"/></label><label>Ngày bắt đầu<input asp-for="StartDate" type="date" class="mt-1 w-full rounded-lg border p-3"/></label><label>Ngày kết thúc<input asp-for="EndDate" type="date" class="mt-1 w-full rounded-lg border p-3"/></label><label>Giá thuê<input asp-for="MonthlyRent" class="mt-1 w-full rounded-lg border p-3"/></label><label>Tiền cọc<input asp-for="DepositAmount" class="mt-1 w-full rounded-lg border p-3"/></label><label>Giá điện<input asp-for="ElectricityPrice" class="mt-1 w-full rounded-lg border p-3"/></label><label>Giá nước<input asp-for="WaterPrice" class="mt-1 w-full rounded-lg border p-3"/></label><button class="rounded-xl bg-indigo-600 px-5 py-3 text-white sm:col-span-2">Lưu nháp</button></form>
