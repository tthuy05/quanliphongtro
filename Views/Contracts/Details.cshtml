@model TroiSinhVien.Models.ViewModels.ContractDetailsViewModel
@{ Layout="_ManagementLayout"; ViewData["Title"]=$"Hợp đồng {Model.ContractCode}"; }
<div class="flex flex-wrap items-start justify-between gap-3"><div><h1 class="text-2xl font-bold">@Model.ContractCode</h1><p class="text-sm text-slate-500">@Model.BoardingHouseName · Phòng @Model.RoomCode · @Model.Status</p></div><a asp-action="Index" class="text-indigo-600">Quay lại</a></div>
<div class="mt-6 grid gap-5 lg:grid-cols-3"><section class="rounded-2xl bg-white p-5 lg:col-span-2"><h2 class="font-bold">Thông tin hợp đồng</h2><dl class="mt-4 grid gap-4 text-sm sm:grid-cols-2"><div><dt class="text-slate-500">Đại diện</dt><dd class="font-semibold">@Model.RepresentativeTenantName</dd></div><div><dt class="text-slate-500">Thời hạn</dt><dd>@Model.StartDate – @Model.EndDate</dd></div><div><dt class="text-slate-500">Giá thuê</dt><dd>@Model.MonthlyRent.ToString("N0") ₫</dd></div><div><dt class="text-slate-500">Tiền cọc</dt><dd>@Model.DepositAmount.ToString("N0") ₫</dd></div><div><dt class="text-slate-500">Điện</dt><dd>@Model.ElectricityPrice.ToString("N0") ₫</dd></div><div><dt class="text-slate-500">Nước</dt><dd>@Model.WaterPrice.ToString("N0") ₫</dd></div></dl>@if(Model.Status==TroiSinhVien.Domain.Enums.ContractStatus.Active){<form asp-action="Extend" method="post" class="mt-5 flex flex-wrap items-end gap-2"><input type="hidden" name="id" value="@Model.Id"/><label class="text-sm">Gia hạn đến<input type="date" name="newEndDate" min="@Model.EndDate.AddDays(1).ToString("yyyy-MM-dd")" class="mt-1 block rounded-lg border p-2" required/></label><button class="rounded-lg bg-indigo-600 px-4 py-2 text-white">Gia hạn</button></form>}</section>
<section class="rounded-2xl bg-white p-5"><h2 class="font-bold">Thành viên</h2><ul class="mt-3 space-y-2 text-sm">@foreach(var member in Model.Members){<li><b>@member.FullName</b>@if(member.IsRepresentative){<span class="ml-2 text-xs text-indigo-600">Đại diện</span>}</li>}</ul>@if(Model.Status==TroiSinhVien.Domain.Enums.ContractStatus.Draft && Model.AvailableTenants.Count>0){<form asp-action="AddMember" method="post" class="mt-4 space-y-2"><input type="hidden" name="ContractId" value="@Model.Id"/><select name="TenantId" class="w-full rounded-lg border p-2">@foreach(var tenant in Model.AvailableTenants){<option value="@tenant.Id">@tenant.Label</option>}</select><button class="rounded-lg bg-slate-900 px-3 py-2 text-white">Thêm thành viên</button></form>}</section></div>
<section class="mt-5 rounded-2xl bg-white p-5"><div class="flex items-center justify-between"><h2 class="font-bold">Dịch vụ áp dụng</h2><a asp-controller="PropertyServices" asp-action="Index" class="text-sm text-indigo-600">Danh mục dịch vụ</a></div><div class="mt-3 grid gap-3 md:grid-cols-2">@foreach(var service in Model.Services){<div class="rounded-xl bg-slate-50 p-3"><b>@service.Name</b><div class="text-sm text-slate-500">@service.CalculationType · @service.Quantity.ToString("N2") @service.Unit × @service.UnitPrice.ToString("N0") ₫</div></div>}@if(Model.Services.Count==0){<p class="text-sm text-slate-500">Chưa gắn dịch vụ.</p>}</div>@if(Model.AvailableServices.Count>0){<form asp-controller="PropertyServices" asp-action="AddToContract" method="post" class="mt-4 grid gap-2 md:grid-cols-4"><input type="hidden" name="ContractId" value="@Model.Id"/><select name="PropertyServiceId" class="rounded-lg border p-2 md:col-span-2">@foreach(var service in Model.AvailableServices){<option value="@service.Id">@service.Label</option>}</select><input name="Quantity" type="number" min="0.01" step="0.01" value="1" aria-label="Số lượng cho cách tính theo đơn vị hoặc tùy chỉnh" placeholder="Số lượng" class="rounded-lg border p-2"/><input name="UnitPriceOverride" type="number" min="0" step="1000" aria-label="Đơn giá thỏa thuận, để trống dùng giá danh mục" placeholder="Đơn giá riêng" class="rounded-lg border p-2"/><button class="rounded-lg bg-indigo-600 px-4 py-2 text-white md:col-span-4">Gắn dịch vụ</button></form>}</section>
@if(Model.Status is TroiSinhVien.Domain.Enums.ContractStatus.Draft or TroiSinhVien.Domain.Enums.ContractStatus.Active){<section class="mt-5 rounded-2xl border border-rose-100 bg-rose-50 p-5"><h2 class="font-bold text-rose-700">Hủy hợp đồng</h2><form asp-action="Cancel" method="post" class="mt-3 flex flex-wrap gap-2"><input type="hidden" name="id" value="@Model.Id"/><input name="reason" required maxlength="500" placeholder="Lý do hủy" class="min-w-72 flex-1 rounded-lg border p-2"/><button class="rounded-lg bg-rose-600 px-4 py-2 text-white">Hủy hợp đồng</button></form></section>}
