@model IReadOnlyList<TroiSinhVien.Models.ViewModels.ContractListItem>
@{ Layout="_ManagementLayout"; ViewData["Title"]="Hợp đồng"; }
<div class="flex justify-between"><h1 class="text-2xl font-bold">Hợp đồng</h1><a href="/Contracts/Create" class="rounded-xl bg-indigo-600 px-4 py-2 text-white">Tạo hợp đồng</a></div><div class="mt-6 overflow-x-auto rounded-2xl bg-white"><table class="w-full text-sm"><thead class="bg-slate-50 text-left"><tr><th class="p-4">Mã</th><th>Phòng</th><th>Đại diện</th><th>Thời hạn</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr class="border-t"><td class="p-4 font-semibold"><a class="text-indigo-600" asp-action="Details" asp-route-id="@x.Id">@x.ContractCode</a></td><td>@x.RoomCode</td><td>@x.TenantName</td><td>@x.StartDate – @x.EndDate</td><td>@x.Status</td><td class="flex gap-2 py-3">@if(x.Status==TroiSinhVien.Domain.Enums.ContractStatus.Draft){<form asp-action="Activate" method="post"><input type="hidden" name="id" value="@x.Id"/><button class="text-emerald-600">Kích hoạt</button></form>}@if(x.Status==TroiSinhVien.Domain.Enums.ContractStatus.Active){<form asp-action="End" method="post"><input type="hidden" name="id" value="@x.Id"/><input type="hidden" name="completeMoveOut" value="true"/><button class="text-rose-600">Trả phòng</button></form>}</td></tr>}@if(Model.Count==0){<tr><td colspan="6" class="p-10 text-center text-slate-500">Chưa có hợp đồng.</td></tr>}</tbody></table></div>
