# Copy to .env for Docker Compose. Never commit the resulting .env file.
POSTGRES_DB=tro_sinh_vien
POSTGRES_USER=tro_sinh_vien_app
POSTGRES_PASSWORD=replace-with-a-long-local-secret
BOOTSTRAP_ADMIN=false

# Optional development seed accounts. Passwords must satisfy the Identity policy.
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=replace-with-a-development-password
SEED_OWNER_EMAIL=owner@example.test
SEED_OWNER_PASSWORD=replace-with-a-development-password
SEED_TENANT_EMAIL=tenant@example.test
SEED_TENANT_PASSWORD=replace-with-a-development-password
